@model autobase.Models.DTOs.MyRequestDto
@{
    ViewBag.Title = "My Requests";
    ViewBag.ActiveNav = "MyRequests";
    ViewBag.PageSubtitle = "Track the status of all your vehicle requests";
    Layout = "~/Views/EmployeeDashboard/_EmployeeLayout.cshtml";
}

@section Styles {
    <style>
        .page-title {
            font-size: 24px;
            font-weight: 800;
            color: #0d0d0d;
            letter-spacing: -.3px;
            animation: fadeUp .3s ease both;
        }

        .page-sub {
            font-size: 13px;
            color: #aaa;
            margin-top: 3px;
            margin-bottom: 24px;
            animation: fadeUp .3s ease both;
        }

        /* ── Alert ── */
        .alert {
            padding: 14px 18px;
            border-radius: 10px;
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 10px;
            animation: fadeUp .3s ease both;
        }

        .alert-success {
            background: #dcfce7;
            color: #166534;
            border: 1px solid #bbf7d0;
        }

        .alert-error {
            background: #fee2e2;
            color: #991b1b;
            border: 1px solid #fecaca;
        }

        /* ── Summary chips ── */
        .summary-row {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
            margin-bottom: 22px;
            animation: fadeUp .35s ease .05s both;
        }

        .summary-chip {
            display: flex;
            align-items: center;
            gap: 8px;
            background: #fff;
            border: 1px solid #efefef;
            border-radius: 10px;
            padding: 12px 18px;
            min-width: 120px;
        }

        .chip-dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            flex-shrink: 0;
        }

            .chip-dot.all {
                background: #aaa;
            }

            .chip-dot.pending {
                background: #F5C518;
            }

            .chip-dot.approved {
                background: #38a169;
            }

            .chip-dot.rejected {
                background: #e53e3e;
            }

            .chip-dot.returned {
                background: #3182ce;
            }

        .chip-num {
            font-size: 22px;
            font-weight: 800;
            color: #0d0d0d;
        }

        .chip-lbl {
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
            color: #aaa;
        }

        /* ── Table card ── */
        .table-card {
            background: #fff;
            border: 1px solid #f0f0f0;
            border-radius: 14px;
            overflow: hidden;
            animation: fadeUp .4s ease .1s both;
        }

        .table-card-header {
            padding: 16px 22px;
            border-bottom: 1px solid #f5f5f5;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .table-card-title {
            font-size: 14px;
            font-weight: 700;
            color: #0d0d0d;
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .table-card-title svg {
                color: #F5C518;
            }

        .count-badge {
            background: #f5f5f5;
            color: #555;
            font-size: 11px;
            font-weight: 700;
            padding: 3px 10px;
            border-radius: 20px;
        }

        /* ── Main table ── */
        .req-table {
            width: 100%;
            border-collapse: collapse;
        }

            .req-table th {
                font-size: 9px;
                font-weight: 700;
                letter-spacing: 1.3px;
                text-transform: uppercase;
                color: #bbb;
                padding: 11px 20px;
                text-align: left;
                background: #fafafa;
                border-bottom: 1px solid #f0f0f0;
                white-space: nowrap;
            }

            .req-table td {
                padding: 14px 20px;
                font-size: 13px;
                color: #555;
                border-bottom: 1px solid #f9f9f9;
                vertical-align: middle;
            }

            .req-table tr:last-child td {
                border-bottom: none;
            }

            .req-table tr:hover td {
                background: #fafafa;
            }

        /* row number */
        .row-num {
            font-size: 12px;
            color: #ddd;
            font-weight: 600;
        }

        /* vehicle name */
        .v-name {
            font-size: 14px;
            font-weight: 700;
            color: #0d0d0d;
        }

        /* reg tag */
        .reg-tag {
            display: inline-block;
            font-size: 11px;
            font-weight: 700;
            padding: 4px 10px;
            border-radius: 6px;
            background: #f5f5f5;
            color: #555;
            border: 1px solid #eee;
            letter-spacing: .5px;
        }

        /* date cells */
        .date-main {
            font-size: 13px;
            font-weight: 600;
            color: #0d0d0d;
        }

        .date-sub {
            font-size: 11px;
            color: #bbb;
            margin-top: 2px;
        }

        /* duration pill */
        .dur-pill {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            font-size: 13px;
            font-weight: 700;
            color: #1d4ed8;
        }

        /* purpose */
        .purpose-cell {
            max-width: 160px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            font-size: 13px;
            color: #555;
        }

        /* status badges */
        .status-pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 4px 12px;
            border-radius: 50px;
            font-size: 11px;
            font-weight: 700;
        }

        .status-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
        }

        .status-pill.pending {
            background: #fef9c3;
            color: #a16207;
            border: 1px solid #fde68a;
        }

        .status-dot.pending {
            background: #ca8a04;
        }

        .status-pill.approved {
            background: #dcfce7;
            color: #166534;
            border: 1px solid #bbf7d0;
        }

        .status-dot.approved {
            background: #38a169;
        }

        .status-pill.rejected {
            background: #fee2e2;
            color: #991b1b;
            border: 1px solid #fecaca;
        }

        .status-dot.rejected {
            background: #e53e3e;
        }

        .status-pill.returned {
            background: #dbeafe;
            color: #1d4ed8;
            border: 1px solid #bfdbfe;
        }

        .status-dot.returned {
            background: #3182ce;
        }

        /* admin notes */
        .admin-note {
            display: inline-block;
            max-width: 130px;
            font-size: 12px;
            color: #555;
            background: #f5f5f5;
            border: 1px solid #eee;
            border-radius: 6px;
            padding: 4px 10px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

            .admin-note.empty {
                color: #ccc;
                font-style: italic;
                background: transparent;
                border: none;
                padding: 0;
            }

        /* return button */
        .btn-return {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 7px 14px;
            background: #dcfce7;
            color: #166534;
            border: 1px solid #bbf7d0;
            border-radius: 8px;
            font-family: 'Barlow', sans-serif;
            font-size: 12px;
            font-weight: 700;
            cursor: pointer;
            transition: background .2s, border-color .2s;
            white-space: nowrap;
        }

            .btn-return:hover {
                background: #bbf7d0;
                border-color: #86efac;
            }

        /* empty state */
        .empty-state {
            text-align: center;
            padding: 60px 20px;
        }

            .empty-state svg {
                color: #e0e0e0;
                margin-bottom: 12px;
            }

            .empty-state p {
                font-size: 13px;
                color: #bbb;
            }

            .empty-state a {
                display: inline-flex;
                align-items: center;
                gap: 6px;
                margin-top: 16px;
                padding: 10px 20px;
                background: #F5C518;
                color: #0d0d0d;
                border-radius: 8px;
                font-size: 13px;
                font-weight: 700;
                text-decoration: none;
                transition: background .2s;
            }

                .empty-state a:hover {
                    background: #d4a800;
                }
    </style>
}

<div class="page-title">My Requests</div>
<div class="page-sub">All vehicle requests you have submitted — track approval status and return vehicles.</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 11.08V12a10 10 0 11-5.93-9.14" />
            <polyline points="22 4 12 14.01 9 11.01" />
        </svg>
        @TempData["SuccessMessage"]
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-error">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10" />
            <line x1="15" y1="9" x2="9" y2="15" />
            <line x1="9" y1="9" x2="15" y2="15" />
        </svg>
        @TempData["ErrorMessage"]
    </div>
}

<!-- Summary chips -->
<div class="summary-row">
    <div class="summary-chip">
        <span class="chip-dot all"></span>
        <div>
            <div class="chip-num">@Model.Requests.Count</div>
            <div class="chip-lbl">Total</div>
        </div>
    </div>
    <div class="summary-chip">
        <span class="chip-dot pending"></span>
        <div>
            <div class="chip-num">@Model.Requests.Count(r => r.Status == "Pending")</div>
            <div class="chip-lbl">Pending</div>
        </div>
    </div>
    <div class="summary-chip">
        <span class="chip-dot approved"></span>
        <div>
            <div class="chip-num">@Model.Requests.Count(r => r.Status == "Approved")</div>
            <div class="chip-lbl">Approved</div>
        </div>
    </div>
    <div class="summary-chip">
        <span class="chip-dot rejected"></span>
        <div>
            <div class="chip-num">@Model.Requests.Count(r => r.Status == "Rejected")</div>
            <div class="chip-lbl">Rejected</div>
        </div>
    </div>
    <div class="summary-chip">
        <span class="chip-dot returned"></span>
        <div>
            <div class="chip-num">@Model.Requests.Count(r => r.Status == "Returned")</div>
            <div class="chip-lbl">Returned</div>
        </div>
    </div>
</div>

<!-- Table card -->
<div class="table-card">
    <div class="table-card-header">
        <div class="table-card-title">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z" />
                <polyline points="14 2 14 8 20 8" />
            </svg>
            MY REQUESTS (@Model.Requests.Count)
        </div>
        <a href="@Url.Action("NewRequest","EmployeeDashboard")"
           style="display:inline-flex;align-items:center;gap:6px;padding:8px 16px;background:#F5C518;color:#0d0d0d;border-radius:8px;font-size:13px;font-weight:700;text-decoration:none;">
            + New Request
        </a>
    </div>

    @if (!Model.Requests.Any())
    {
        <div class="empty-state">
            <svg width="52" height="52" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z" />
                <polyline points="14 2 14 8 20 8" />
            </svg>
            <p>You haven't submitted any requests yet.</p>
            <a href="@Url.Action("NewRequest","EmployeeDashboard")">+ Make Your First Request</a>
        </div>
    }
    else
    {
        <table class="req-table">
            <thead>
                <tr>
                    <th style="width:44px;">#</th>
                    <th>Vehicle</th>
                    <th>Reg No</th>
                    <th>Start</th>
                    <th>End</th>
                    <th>Duration</th>
                    <th>Purpose</th>
                    <th>Reporting Place</th>
                    <th>Status</th>
                    <th>Admin Notes</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @{ int i = 1; }
                @foreach (var r in Model.Requests)
                {
                    string sc = r.Status == "Approved" ? "approved"
                              : r.Status == "Rejected" ? "rejected"
                              : r.Status == "Returned" ? "returned"
                              : "pending";

                    double hrs = r.DurationHours;
                    string durLabel = hrs >= 1
                        ? hrs.ToString("0.#") + " hrs"
                        : ((int)(hrs * 60)) + " min";

                    <tr>
                        <td><span class="row-num">@i</span></td>
                        <td><span class="v-name">@r.VehicleName</span></td>
                        <td><span class="reg-tag">@r.RegistrationNo</span></td>
                        <td>
                            <div class="date-main">@r.RequiredFrom.ToString("dd MMM, hh:mm tt")</div>
                        </td>
                        <td>
                            <div class="date-main">@r.RequiredUntil.ToString("dd MMM, hh:mm tt")</div>
                        </td>
                        <td>
                            <span class="dur-pill">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="12" cy="12" r="10" />
                                    <polyline points="12 6 12 12 16 14" />
                                </svg>
                                @durLabel
                            </span>
                        </td>
                        <td>
                            <span class="purpose-cell" title="@r.Purpose">@r.Purpose</span>
                        </td>
                        <td>
                            <span class="purpose-cell" title="@r.ReportingPlace">@r.ReportingPlace</span>
                        </td>
                        <td>
                            <span class="status-pill @sc">
                                <span class="status-dot @sc"></span>
                                @r.Status
                            </span>
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(r.AdminNotes))
                            {
                                <span class="admin-note" title="@r.AdminNotes">@r.AdminNotes</span>
                            }
                            else
                            {
                                <span class="admin-note empty">—</span>
                            }
                        </td>
                        <td>
                            @if (r.Status == "Approved")
                            {
                                using (Html.BeginForm("ReturnVehicle", "EmployeeDashboard", FormMethod.Post, new { style = "display:inline;" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="requestId" value="@r.RequestId" />
                                    <button type="submit" class="btn-return"
                                            onclick="return confirm('Confirm vehicle return?')">
                                        ✓ Return Vehicle
                                    </button>
                                }
                            }
                            else
                            {
                                <span style="font-size:12px;color:#ccc;">—</span>
                            }
                        </td>
                    </tr>
                    i++;
                }
            </tbody>
        </table>
    }
</div>
