@model Autobase_vts.Models.DTOs.AllocatedVehicleDto
@{
    ViewBag.Title = "My Allocated Vehicle";
    ViewBag.ActiveNav = "AllocatedVehicle";
    ViewBag.PageSubtitle = "Vehicles currently approved and in your use";
    Layout = "~/Views/EmployeeDashboard/_EmployeeLayout.cshtml";
}

@section Styles {
    <style>
        .page-title {
            font-size: 24px;
            font-weight: 800;
            color: #0d0d0d;
            letter-spacing: -.3px;
            animation: fadeUp .3s ease both;
        }

        .page-sub {
            font-size: 13px;
            color: #aaa;
            margin-top: 3px;
            margin-bottom: 24px;
            animation: fadeUp .3s ease both;
        }

        /* ── Alert ── */
        .alert {
            padding: 14px 18px;
            border-radius: 10px;
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 10px;
            animation: fadeUp .3s ease both;
        }

        .alert-success {
            background: #dcfce7;
            color: #166534;
            border: 1px solid #bbf7d0;
        }

        .alert-error {
            background: #fee2e2;
            color: #991b1b;
            border: 1px solid #fecaca;
        }

        /* ── Summary chips ── */
        .summary-row {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
            margin-bottom: 22px;
            animation: fadeUp .35s ease .05s both;
        }

        .summary-chip {
            display: flex;
            align-items: center;
            gap: 8px;
            background: #fff;
            border: 1px solid #efefef;
            border-radius: 10px;
            padding: 12px 18px;
            min-width: 120px;
        }

        .chip-dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            flex-shrink: 0;
        }

            .chip-dot.all {
                background: #aaa;
            }

            .chip-dot.inuse {
                background: #38a169;
            }

            .chip-dot.overdue {
                background: #e53e3e;
            }

        .chip-num {
            font-size: 22px;
            font-weight: 800;
            color: #0d0d0d;
        }

        .chip-lbl {
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
            color: #aaa;
        }

        /* ── Cards grid ── */
        .cards-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
            gap: 16px;
            animation: fadeUp .4s ease .1s both;
        }

        .alloc-card {
            background: #fff;
            border: 1px solid #f0f0f0;
            border-radius: 14px;
            overflow: hidden;
            transition: box-shadow .2s, transform .2s;
        }

            .alloc-card:hover {
                box-shadow: 0 8px 24px rgba(0,0,0,.06);
                transform: translateY(-2px);
            }

            .alloc-card.overdue {
                border-color: #fecaca;
            }

        /* card header strip */
        .card-header {
            padding: 14px 18px 12px;
            border-bottom: 1px solid #f5f5f5;
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 10px;
        }

            .card-header.overdue-header {
                background: #fff5f5;
                border-bottom-color: #fecaca;
            }

        .v-name-big {
            font-size: 16px;
            font-weight: 800;
            color: #0d0d0d;
            line-height: 1.2;
        }

        .reg-tag {
            display: inline-block;
            font-size: 11px;
            font-weight: 700;
            padding: 3px 9px;
            border-radius: 6px;
            background: #f5f5f5;
            color: #555;
            border: 1px solid #eee;
            letter-spacing: .5px;
            margin-top: 4px;
        }

        .overdue-badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 4px 10px;
            border-radius: 50px;
            background: #fee2e2;
            color: #991b1b;
            border: 1px solid #fecaca;
            font-size: 11px;
            font-weight: 700;
            white-space: nowrap;
            flex-shrink: 0;
        }

        .inuse-badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 4px 10px;
            border-radius: 50px;
            background: #dcfce7;
            color: #166534;
            border: 1px solid #bbf7d0;
            font-size: 11px;
            font-weight: 700;
            white-space: nowrap;
            flex-shrink: 0;
        }

        .badge-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
        }

            .badge-dot.overdue {
                background: #e53e3e;
            }

            .badge-dot.inuse {
                background: #38a169;
            }

        /* card body */
        .card-body {
            padding: 14px 18px;
        }

        .info-row {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            margin-bottom: 10px;
        }

        .info-icon {
            width: 30px;
            height: 30px;
            border-radius: 8px;
            background: #f7f7f7;
            border: 1px solid #f0f0f0;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            color: #aaa;
        }

        .info-label {
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #bbb;
        }

        .info-value {
            font-size: 13px;
            font-weight: 600;
            color: #0d0d0d;
            margin-top: 1px;
        }

        .info-sub {
            font-size: 11px;
            color: #aaa;
            margin-top: 1px;
        }

        /* timing row */
        .timing-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            margin-bottom: 12px;
        }

        .timing-cell {
            background: #fafafa;
            border: 1px solid #f0f0f0;
            border-radius: 8px;
            padding: 10px 12px;
        }

            .timing-cell.overdue-cell {
                background: #fff5f5;
                border-color: #fecaca;
            }

        .timing-lbl {
            font-size: 9px;
            font-weight: 700;
            letter-spacing: 1.2px;
            text-transform: uppercase;
            color: #bbb;
            margin-bottom: 4px;
        }

        .timing-val {
            font-size: 13px;
            font-weight: 700;
            color: #0d0d0d;
        }

        .timing-sub {
            font-size: 10px;
            color: #aaa;
            margin-top: 2px;
        }

        .timing-overdue-val {
            color: #e53e3e;
        }

        /* progress bar */
        .progress-wrap {
            margin-bottom: 14px;
        }

        .progress-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 5px;
        }

        .progress-lbl {
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #bbb;
        }

        .progress-val {
            font-size: 11px;
            font-weight: 700;
            color: #e53e3e;
        }

        .progress-bar {
            height: 6px;
            background: #f0f0f0;
            border-radius: 10px;
            overflow: hidden;
        }

        .progress-fill {
            height: 100%;
            border-radius: 10px;
            background: linear-gradient(90deg, #ef4444, #dc2626);
            transition: width .6s ease;
        }

        /* purpose pill */
        .purpose-row {
            background: #f7f7f7;
            border: 1px solid #f0f0f0;
            border-radius: 8px;
            padding: 8px 12px;
            margin-bottom: 14px;
            font-size: 12px;
            color: #555;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .purpose-lbl {
            font-size: 9px;
            font-weight: 700;
            letter-spacing: 1.2px;
            text-transform: uppercase;
            color: #bbb;
            margin-bottom: 3px;
        }

        /* card footer: return button */
        .card-footer {
            padding: 12px 18px;
            border-top: 1px solid #f5f5f5;
        }

        .btn-return {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            width: 100%;
            padding: 10px 14px;
            background: #dcfce7;
            color: #166534;
            border: 1px solid #bbf7d0;
            border-radius: 8px;
            font-family: 'Barlow', sans-serif;
            font-size: 13px;
            font-weight: 700;
            cursor: pointer;
            transition: background .2s, border-color .2s;
        }

            .btn-return:hover {
                background: #bbf7d0;
                border-color: #86efac;
            }

            .btn-return.overdue-btn {
                background: #fee2e2;
                color: #991b1b;
                border-color: #fecaca;
            }

                .btn-return.overdue-btn:hover {
                    background: #fecaca;
                    border-color: #fca5a5;
                }

        /* ── Empty state ── */
        .empty-wrap {
            background: #fff;
            border: 1px solid #f0f0f0;
            border-radius: 14px;
            text-align: center;
            padding: 70px 20px;
            animation: fadeUp .4s ease .1s both;
        }

            .empty-wrap svg {
                color: #e0e0e0;
                margin-bottom: 14px;
            }

            .empty-wrap p {
                font-size: 13px;
                color: #bbb;
                margin-bottom: 16px;
            }

            .empty-wrap a {
                display: inline-flex;
                align-items: center;
                gap: 6px;
                padding: 10px 22px;
                background: #F5C518;
                color: #0d0d0d;
                border-radius: 8px;
                font-size: 13px;
                font-weight: 700;
                text-decoration: none;
                transition: background .2s;
            }

                .empty-wrap a:hover {
                    background: #d4a800;
                }
    </style>
}

<div class="page-title">My Allocated Vehicle</div>
<div class="page-sub">All vehicles currently approved for your use — return them when done.</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 11.08V12a10 10 0 11-5.93-9.14" />
            <polyline points="22 4 12 14.01 9 11.01" />
        </svg>
        @TempData["SuccessMessage"]
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-error">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10" />
            <line x1="15" y1="9" x2="9" y2="15" />
            <line x1="9" y1="9" x2="15" y2="15" />
        </svg>
        @TempData["ErrorMessage"]
    </div>
}

<!-- Summary chips -->
<div class="summary-row">
    <div class="summary-chip">
        <span class="chip-dot all"></span>
        <div>
            <div class="chip-num">@Model.TotalAllocated</div>
            <div class="chip-lbl">Total</div>
        </div>
    </div>
    <div class="summary-chip">
        <span class="chip-dot inuse"></span>
        <div>
            <div class="chip-num">@Model.InUseCount</div>
            <div class="chip-lbl">In Use</div>
        </div>
    </div>
    <div class="summary-chip">
        <span class="chip-dot overdue"></span>
        <div>
            <div class="chip-num">@Model.OverdueCount</div>
            <div class="chip-lbl">Overdue</div>
        </div>
    </div>
</div>

<!-- Cards or empty -->
@if (!Model.Items.Any())
{
    <div class="empty-wrap">
        <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z" />
            <circle cx="12" cy="10" r="3" />
        </svg>
        <p>You have no approved vehicles at the moment.</p>
        <a href="@Url.Action("NewRequest","EmployeeDashboard")">+ Make a New Request</a>
    </div>
}
else
{
    <div class="cards-grid">
        @foreach (var item in Model.Items)
        {
            string durText = item.DurationHours > 0
                ? item.DurationHours + "h " + item.DurationMins + "m"
                : item.DurationMins + " min";

            string overdueText = item.IsOverdue
                ? ((int)item.OverdueBy.TotalHours > 0
                    ? (int)item.OverdueBy.TotalHours + "h " + item.OverdueBy.Minutes + "m overdue"
                    : item.OverdueBy.Minutes + " min overdue")
                : "";

            <div class="alloc-card @(item.IsOverdue ? "overdue" : "")">

                <!-- Card header -->
                <div class="card-header @(item.IsOverdue ? "overdue-header" : "")">
                    <div>
                        <div class="v-name-big">@item.VehicleName</div>
                        <span class="reg-tag">@item.RegistrationNo</span>
                    </div>
                    @if (item.IsOverdue)
                    {
                        <span class="overdue-badge">
                            <span class="badge-dot overdue"></span>
                            Overdue
                        </span>
                    }
                    else
                    {
                        <span class="inuse-badge">
                            <span class="badge-dot inuse"></span>
                            In Use
                        </span>
                    }
                </div>

                <!-- Card body -->
                <div class="card-body">

                    <!-- Timing grid -->
                    <div class="timing-row">
                        <div class="timing-cell">
                            <div class="timing-lbl">Start</div>
                            <div class="timing-val">@item.StartTime.ToString("dd MMM")</div>
                            <div class="timing-sub">@item.StartTime.ToString("hh:mm tt")</div>
                        </div>
                        <div class="timing-cell @(item.IsOverdue ? "overdue-cell" : "")">
                            <div class="timing-lbl">Due Return</div>
                            <div class="timing-val @(item.IsOverdue ? "timing-overdue-val" : "")">
                                @item.DueReturn.ToString("dd MMM")
                            </div>
                            <div class="timing-sub">@item.DueReturn.ToString("hh:mm tt")</div>
                        </div>
                    </div>

                    <!-- Duration row -->
                    <div class="info-row">
                        <div class="info-icon">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="10" />
                                <polyline points="12 6 12 12 16 14" />
                            </svg>
                        </div>
                        <div>
                            <div class="info-label">Duration</div>
                            <div class="info-value">@durText</div>
                        </div>
                    </div>

                    <!-- Overdue progress bar (only when overdue) -->
                    @if (item.IsOverdue)
                    {
                        <div class="progress-wrap">
                            <div class="progress-top">
                                <span class="progress-lbl">Overdue by</span>
                                <span class="progress-val">@overdueText</span>
                            </div>
                            <div class="progress-bar">
                                <div class="progress-fill" style="width:@item.OverduePercent%"></div>
                            </div>
                        </div>
                    }

                    <!-- Purpose -->
                    <div>
                        <div class="purpose-lbl">Purpose</div>
                        <div class="purpose-row" title="@item.Purpose">@item.Purpose</div>
                    </div>

                </div>

                <!-- Card footer: return action -->
                <div class="card-footer">
                    @using (Html.BeginForm("ReturnVehicle", "EmployeeDashboard", FormMethod.Post, new { style = "margin:0;" }))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="requestId" value="@item.RequestId" />
                        <button type="submit"
                                class="btn-return @(item.IsOverdue ? "overdue-btn" : "")"
                                onclick="return confirm('Confirm vehicle return for @item.VehicleName?')">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M22 11.08V12a10 10 0 11-5.93-9.14" />
                                <polyline points="22 4 12 14.01 9 11.01" />
                            </svg>
                            @(item.IsOverdue ? "Return Now (Overdue)" : "Return Vehicle")
                        </button>
                    }
                </div>

            </div>
        }
    </div>
}
