@model autobase.Models.DTOs.NewRequestDto
@{
    ViewBag.Title = "New Request";
    Layout = null;

    string fullName = Session["FullName"]?.ToString() ?? "Employee";
    string empNo = Session["EmployeeNumber"]?.ToString() ?? "";
    string initials = string.IsNullOrEmpty(fullName) ? "E" : fullName.Substring(0, 1).ToUpper();

    var now = DateTime.Now;
    int hour = now.Hour;
    string greeting = hour < 12 ? "Good morning" : hour < 17 ? "Good afternoon" : "Good evening";

    int availCount = Model.AvailableVehicles.Count(v => v.IsAvailable);
    int inUseCount = Model.AvailableVehicles.Count(v => !v.IsAvailable);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>AutoBase — New Request</title>
    <link href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600;700;800&family=Barlow+Condensed:wght@700;800&display=swap" rel="stylesheet" />
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        body { font-family: 'Barlow', sans-serif; background: #f8f8f8; color: #0d0d0d; min-height: 100vh; }

        .emp-layout { display: flex; min-height: 100vh; }

        /* Sidebar */
        .emp-sidebar { width: 200px; min-width: 200px; background: #fff; border-right: 1px solid #f0f0f0; display: flex; flex-direction: column; height: 100vh; position: fixed; left: 0; top: 0; z-index: 100; }
        .emp-logo { display: flex; align-items: center; gap: 8px; padding: 20px 16px 16px; border-bottom: 1px solid #f5f5f5; }
        .emp-logo-icon { width: 32px; height: 32px; background: #F5C518; border-radius: 8px; display: flex; align-items: center; justify-content: center; }
        .emp-logo-icon svg { width: 20px; height: 20px; }
        .emp-logo-text { font-family: 'Barlow Condensed', sans-serif; font-size: 17px; font-weight: 800; letter-spacing: 1px; color: #0d0d0d; }
        .logo-y { color: #F5C518; }
        .emp-nav { flex: 1; padding: 12px 10px; display: flex; flex-direction: column; gap: 1px; }
        .nav-label { font-size: 9px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; color: #bbb; padding: 10px 8px 4px; margin-top: 4px; }
        .nav-link { display: flex; align-items: center; gap: 9px; padding: 8px 10px; border-radius: 8px; font-size: 13px; font-weight: 500; color: #555; text-decoration: none; transition: background .15s, color .15s; }
        .nav-link svg { flex-shrink: 0; opacity: .7; }
        .nav-link:hover { background: #f7f7f7; color: #0d0d0d; }
        .nav-link:hover svg { opacity: 1; }
        .nav-link.active { background: #fff8dc; color: #0d0d0d; font-weight: 600; }
        .nav-link.active svg { opacity: 1; color: #c9a000; }
        .emp-sidebar-footer { padding: 14px; border-top: 1px solid #f0f0f0; display: flex; align-items: center; gap: 10px; }
        .emp-s-avatar { width: 34px; height: 34px; border-radius: 50%; background: #F5C518; display: flex; align-items: center; justify-content: center; font-size: 14px; font-weight: 700; color: #0d0d0d; flex-shrink: 0; }
        .emp-s-info { display: flex; flex-direction: column; overflow: hidden; }
        .emp-s-name { font-size: 12px; font-weight: 600; color: #0d0d0d; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .emp-s-meta { font-size: 10px; color: #999; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

        /* Topbar */
        .emp-topbar { height: 60px; background: #fff; border-bottom: 1px solid #f0f0f0; display: flex; align-items: center; justify-content: space-between; padding: 0 28px; position: fixed; top: 0; left: 200px; right: 0; z-index: 99; }
        .topbar-greet { font-size: 14px; font-weight: 600; color: #0d0d0d; }
        .topbar-sub { font-size: 12px; color: #aaa; margin-top: 1px; }
        .topbar-right { display: flex; align-items: center; gap: 12px; }
        .user-pill { display: flex; align-items: center; gap: 9px; background: #f7f7f7; border: 1px solid #ebebeb; border-radius: 50px; padding: 5px 12px 5px 5px; }
        .pill-avatar { width: 30px; height: 30px; border-radius: 50%; background: #F5C518; display: flex; align-items: center; justify-content: center; font-size: 13px; font-weight: 700; color: #0d0d0d; }
        .pill-name { font-size: 12px; font-weight: 600; color: #0d0d0d; }
        .pill-role { font-size: 10px; color: #999; }
        .logout-btn { display: flex; align-items: center; gap: 7px; padding: 8px 16px; border: 1.5px solid #eee; border-radius: 8px; font-family: 'Barlow', sans-serif; font-size: 13px; font-weight: 600; color: #555; text-decoration: none; background: #fff; transition: border-color .2s, color .2s, background .2s; }
        .logout-btn:hover { border-color: #e53e3e; color: #e53e3e; background: #fff5f5; }

        /* Main */
        .emp-main { margin-left: 200px; padding-top: 60px; flex: 1; }
        .emp-body { padding: 28px; }
        .page-title { font-size: 24px; font-weight: 800; color: #0d0d0d; letter-spacing: -.3px; animation: fadeUp .3s ease both; }
        .page-sub { font-size: 13px; color: #aaa; margin-top: 3px; margin-bottom: 20px; animation: fadeUp .3s ease both; }

        /* Alert */
        .alert { padding: 14px 18px; border-radius: 10px; font-size: 13px; font-weight: 600; margin-bottom: 20px; display: flex; align-items: center; gap: 10px; }
        .alert-success { background: #dcfce7; color: #166534; border: 1px solid #bbf7d0; }
        .alert-error { background: #fee2e2; color: #991b1b; border: 1px solid #fecaca; }

        /* Summary chips */
        .summary-row { display: flex; gap: 12px; margin-bottom: 22px; animation: fadeUp .32s ease .04s both; }
        .sum-chip { display: flex; align-items: center; gap: 10px; background: #fff; border: 1px solid #efefef; border-radius: 10px; padding: 12px 18px; }
        .sum-dot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; }
        .sum-dot.avail { background: #1aaa78; }
        .sum-dot.inuse { background: #3182ce; }
        .sum-num { font-size: 22px; font-weight: 800; color: #0d0d0d; }
        .sum-lbl { font-size: 10px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; color: #aaa; }

        /* Search + filter */
        .search-bar { display: flex; align-items: center; gap: 10px; margin-bottom: 24px; animation: fadeUp .35s ease .05s both; }
        .search-wrap { flex: 1; position: relative; }
        .search-wrap svg { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: #ccc; pointer-events: none; }
        .search-wrap input { width: 100%; height: 44px; padding: 0 16px 0 42px; border: 1.5px solid #e8e8e8; border-radius: 10px; font-family: 'Barlow', sans-serif; font-size: 14px; font-weight: 500; color: #0d0d0d; background: #fff; outline: none; transition: border-color .2s, box-shadow .2s; }
        .search-wrap input:focus { border-color: #1aaa78; box-shadow: 0 0 0 3px rgba(26,170,120,.12); }
        .filter-tabs { display: flex; gap: 6px; }
        .ftab { height: 44px; padding: 0 18px; border: 1.5px solid #e8e8e8; border-radius: 10px; font-family: 'Barlow', sans-serif; font-size: 13px; font-weight: 600; color: #666; background: #fff; cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; transition: border-color .15s, background .15s, color .15s; }
        .ftab:hover { border-color: #ccc; color: #0d0d0d; }
        .ftab.f-all { background: #0d0d0d; border-color: #0d0d0d; color: #fff; }
        .ftab.f-avail { background: #1aaa78; border-color: #1aaa78; color: #fff; }
        .ftab.f-inuse { background: #3182ce; border-color: #3182ce; color: #fff; }

        /* Grid */
        .v-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px; animation: fadeUp .4s ease .1s both; }

        /* Cards */
        .v-card { border-radius: 16px; padding: 20px; position: relative; transition: box-shadow .2s, transform .2s; }
        .v-card.card-avail { background: #e8f8f2; border: 1.5px solid #c6edd9; }
        .v-card.card-avail:hover { box-shadow: 0 6px 24px rgba(26,170,120,.15); transform: translateY(-2px); }
        .v-card.card-inuse { background: #eff6ff; border: 1.5px solid #bfdbfe; }
        .v-card.card-inuse:hover { box-shadow: 0 6px 24px rgba(49,130,206,.15); transform: translateY(-2px); }

        .v-card-dot { position: absolute; top: 16px; right: 16px; width: 11px; height: 11px; border-radius: 50%; }
        .v-card-dot.avail { background: #1aaa78; box-shadow: 0 0 0 3px rgba(26,170,120,.2); }
        .v-card-dot.inuse { background: #3182ce; box-shadow: 0 0 0 3px rgba(49,130,206,.2); }

        .v-type-badge { display: inline-block; font-size: 10px; font-weight: 700; letter-spacing: .8px; text-transform: uppercase; padding: 3px 10px; border-radius: 6px; margin-bottom: 12px; }
        .card-avail .v-type-badge { color: #0d7a52; background: #c6edd9; border: 1px solid #a8dfc6; }
        .card-inuse .v-type-badge { color: #1d4ed8; background: #dbeafe; border: 1px solid #bfdbfe; }

        .v-card-name { font-size: 18px; font-weight: 800; color: #0d0d0d; margin-bottom: 8px; line-height: 1.2; }
        .v-reg-tag { display: inline-block; font-size: 12px; font-weight: 600; padding: 4px 12px; border-radius: 7px; background: #fff; color: #444; letter-spacing: .4px; margin-bottom: 16px; }
        .card-avail .v-reg-tag { border: 1px solid #c6edd9; }
        .card-inuse .v-reg-tag { border: 1px solid #bfdbfe; }

        .v-divider { border: none; border-top: 1px solid; margin-bottom: 14px; }
        .card-avail .v-divider { border-color: #c6edd9; }
        .card-inuse .v-divider { border-color: #bfdbfe; }

        .v-detail-row { display: flex; justify-content: space-between; align-items: center; padding: 4px 0; }
        .v-detail-label { font-size: 13px; font-weight: 500; }
        .card-avail .v-detail-label { color: #5a7a6a; }
        .card-inuse .v-detail-label { color: #3a5a8a; }
        .v-detail-val { font-size: 13px; font-weight: 700; color: #0d0d0d; }
        .v-detail-val.green { color: #1aaa78; }
        .v-detail-val.blue { color: #3182ce; }
        .v-detail-val.notes { color: #5a7a6a; font-weight: 500; }

        /* free-in badge */
        .free-in-badge { display: inline-flex; align-items: center; gap: 5px; background: #fff; border: 1px solid #bfdbfe; border-radius: 6px; padding: 4px 10px; font-size: 12px; font-weight: 700; color: #1d4ed8; margin-top: 10px; }

        /* In-Use status pill */
        .inuse-status-pill { display: inline-flex; align-items: center; gap: 6px; background: #dbeafe; border: 1px solid #bfdbfe; border-radius: 50px; padding: 4px 12px; font-size: 11px; font-weight: 700; color: #1d4ed8; }
        .inuse-status-dot { width: 7px; height: 7px; border-radius: 50%; background: #3182ce; }

        /* Request buttons */
        .v-request-btn { display: flex; align-items: center; justify-content: center; gap: 8px; width: 100%; height: 46px; margin-top: 18px; color: #fff; border: none; border-radius: 10px; font-family: 'Barlow', sans-serif; font-size: 14px; font-weight: 700; cursor: pointer; transition: background .2s, transform .15s; }
        .v-request-btn.btn-avail { background: #1aaa78; }
        .v-request-btn.btn-avail:hover { background: #158a61; transform: scale(1.01); }

        /* Schedule-ahead button for in-use vehicles ── */
        .v-request-btn.btn-schedule { background: #3182ce; }
        .v-request-btn.btn-schedule:hover { background: #2563eb; transform: scale(1.01); }

        /* Empty */
        .empty-state { text-align: center; padding: 60px 20px; background: #fff; border: 1px solid #efefef; border-radius: 14px; }
        .empty-state svg { color: #e0e0e0; margin-bottom: 12px; }
        .empty-state p { font-size: 13px; color: #bbb; }

        /* Modal */
        .modal-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,.4); backdrop-filter: blur(4px); z-index: 999; align-items: center; justify-content: center; }
        .modal-overlay.open { display: flex; }
        .modal { background: #fff; border-radius: 18px; width: 460px; max-width: 96vw; box-shadow: 0 24px 60px rgba(0,0,0,.18); animation: modalIn .25s ease both; overflow: hidden; }

        @@keyframes modalIn {
            from { opacity: 0; transform: scale(.93) translateY(18px); }
            to   { opacity: 1; transform: scale(1) translateY(0); }
        }

        .modal-header { display: flex; align-items: center; justify-content: space-between; padding: 20px 22px; background: #e8f8f2; border-bottom: 1px solid #c6edd9; }
        .modal-header.header-schedule { background: #eff6ff; border-bottom-color: #bfdbfe; }

        .modal-header-left { display: flex; align-items: center; gap: 10px; }
        .modal-title { font-size: 17px; font-weight: 800; color: #0d0d0d; }
        .modal-close { width: 30px; height: 30px; border: none; background: transparent; display: flex; align-items: center; justify-content: center; cursor: pointer; color: #888; border-radius: 6px; transition: background .15s, color .15s; }
        .modal-close:hover { background: #fde8e8; color: #e53e3e; }

        /*  In-use warning banner inside modal ── */
        .modal-inuse-notice { display: none; margin: 14px 22px 0; background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 10px; padding: 12px 14px; gap: 10px; align-items: flex-start; }
        .modal-inuse-notice.visible { display: flex; }
        .modal-inuse-notice svg { flex-shrink: 0; margin-top: 1px; color: #3182ce; }
        .modal-inuse-notice-text { font-size: 12px; font-weight: 600; color: #1d4ed8; line-height: 1.5; }
        .modal-inuse-notice-text span { display: block; font-weight: 800; font-size: 13px; margin-bottom: 2px; }

        .modal-vehicle-block { margin: 14px 22px 0; background: #f5f5f5; border-radius: 12px; padding: 14px 16px; }
        .mvb-name { font-size: 16px; font-weight: 800; color: #0d0d0d; margin-bottom: 6px; }
        .mvb-tags { display: flex; gap: 8px; align-items: center; }
        .mvb-reg { display: inline-block; font-size: 11px; font-weight: 700; padding: 3px 10px; border-radius: 6px; background: #e8e8e8; color: #444; border: 1px solid #ddd; letter-spacing: .4px; }
        .mvb-type { font-size: 11px; font-weight: 600; color: #666; }

        .modal-body { padding: 18px 22px 22px; }
        .form-row-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
        .form-group { margin-bottom: 16px; }
        .form-label { display: block; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; color: #999; margin-bottom: 7px; }
        .form-control { width: 100%; height: 46px; padding: 0 14px; border: 1.5px solid #e8e8e8; border-radius: 10px; font-family: 'Barlow', sans-serif; font-size: 14px; font-weight: 500; color: #0d0d0d; background: #fff; outline: none; transition: border-color .2s, box-shadow .2s; }
        textarea.form-control { height: 100px; padding: 12px 14px; resize: vertical; line-height: 1.5; }
        .form-control:focus { border-color: #1aaa78; box-shadow: 0 0 0 3px rgba(26,170,120,.12); }

        .duration-pill { display: flex; align-items: center; justify-content: center; gap: 8px; background: #e8f8f2; border: 1px solid #c6edd9; border-radius: 10px; padding: 11px 16px; margin-bottom: 16px; font-size: 13px; font-weight: 700; color: #0d7a52; }

        .btn-submit { width: 100%; height: 48px; border: none; border-radius: 12px; background: #1aaa78; color: #fff; font-family: 'Barlow', sans-serif; font-size: 15px; font-weight: 700; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px; transition: background .2s; }
        .btn-submit:hover { background: #158a61; }
        .btn-submit:disabled { opacity: .6; cursor: not-allowed; }
        .btn-submit.btn-submit-schedule { background: #3182ce; }
        .btn-submit.btn-submit-schedule:hover { background: #2563eb; }

        @@keyframes fadeUp {
            from { opacity: 0; transform: translateY(10px); }
            to   { opacity: 1; transform: translateY(0); }
        }
    </style>
</head>
<body>
<div class="emp-layout">

    <!-- Sidebar -->
    <aside class="emp-sidebar">
        <div class="emp-logo">
            <div class="emp-logo-icon">
                <svg viewBox="0 0 24 24" fill="none">
                    <rect x="1" y="5" width="15" height="11" rx="1" fill="#1a1a1a"/>
                    <path d="M16 9h4l3 4v3h-7V9z" fill="#1a1a1a"/>
                    <circle cx="5.5" cy="18.5" r="2.5" fill="#1a1a1a"/>
                    <circle cx="18.5" cy="18.5" r="2.5" fill="#1a1a1a"/>
                </svg>
            </div>
            <span class="emp-logo-text">AUTO<span class="logo-y">BASE</span></span>
        </div>
        <nav class="emp-nav">
            <div class="nav-label">Overview</div>
            <a href="@Url.Action("Index","EmployeeDashboard")" class="nav-link">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
                Dashboard
            </a>
            <div class="nav-label">Vehicles</div>
            <a href="@Url.Action("AvailableVehicles","EmployeeDashboard")" class="nav-link">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                Available Vehicles
            </a>
            <a href="@Url.Action("AllocatedVehicle","EmployeeDashboard")" class="nav-link">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
                My Allocated Vehicle
            </a>
            <div class="nav-label">Requests</div>
            <a href="@Url.Action("MyRequests","EmployeeDashboard")" class="nav-link">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
                My Requests
            </a>
            <a href="@Url.Action("NewRequest","EmployeeDashboard")" class="nav-link active">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
                New Request
            </a>
        </nav>
        <div class="emp-sidebar-footer">
            <div class="emp-s-avatar">@initials</div>
            <div class="emp-s-info">
                <span class="emp-s-name">@fullName</span>
                <span class="emp-s-meta">Employee &middot; #@empNo</span>
            </div>
        </div>
    </aside>

    <!-- Main -->
    <div class="emp-main">
        <header class="emp-topbar">
            <div>
                <div class="topbar-greet">@greeting, @fullName</div>
                <div class="topbar-sub">Pick an available vehicle and submit your request</div>
            </div>
            <div class="topbar-right">
                <div class="user-pill">
                    <div class="pill-avatar">@initials</div>
                    <div>
                        <div class="pill-name">@fullName</div>
                        <div class="pill-role">Employee</div>
                    </div>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#999" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                </div>
                <a href="@Url.Action("Logout","Account")" class="logout-btn">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                    Logout
                </a>
            </div>
        </header>

        <div class="emp-body">
            <div class="page-title">New Vehicle Request</div>
            <div class="page-sub">
                @availCount available · @inUseCount in use — available vehicles can be requested now; in-use vehicles can be scheduled from their free time.
            </div>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                    @TempData["SuccessMessage"]
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-error">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
                    @TempData["ErrorMessage"]
                </div>
            }

            <!-- Summary chips -->
            <div class="summary-row">
                <div class="sum-chip">
                    <span class="sum-dot avail"></span>
                    <div><div class="sum-num">@availCount</div><div class="sum-lbl">Available</div></div>
                </div>
                <div class="sum-chip">
                    <span class="sum-dot inuse"></span>
                    <div><div class="sum-num">@inUseCount</div><div class="sum-lbl">In Use</div></div>
                </div>
            </div>

            <!-- Search + filter -->
            <div class="search-bar">
                <div class="search-wrap">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                    <input type="text" id="searchInput" placeholder="Search by vehicle name or registration…" oninput="liveSearch(this.value)" />
                </div>
                <div class="filter-tabs">
                    <button class="ftab f-all" onclick="filterCards('all')">All</button>
                    <button class="ftab" onclick="filterCards('avail')">Available</button>
                    <button class="ftab" onclick="filterCards('inuse')">In Use</button>
                </div>
            </div>

            @if (!Model.AvailableVehicles.Any())
            {
                <div class="empty-state">
                    <svg width="52" height="52" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13" rx="1"/><path d="M16 8h4l3 4v3h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                    <p>No vehicles found.</p>
                </div>
            }
            else
            {
                <div class="v-grid" id="vehicleGrid">
                    @foreach (var v in Model.AvailableVehicles)
                    {
                        string notes    = string.IsNullOrEmpty(v.Notes) ? "—" : v.Notes;
                        string safeName = v.VehicleName.Replace("'", "\\'").Replace("\"", "&quot;");
                        string safeType = v.VehicleTypeName.Replace("'", "\\'");
                        string cardCls  = v.IsAvailable ? "card-avail" : "card-inuse";
                        string dotCls   = v.IsAvailable ? "avail" : "inuse";

                        // Build the ISO string for FreeAt so JS can parse it reliably
                        string freeAtIso = v.FreeAt.HasValue
                            ? v.FreeAt.Value.ToString("yyyy-MM-ddTHH:mm")
                            : "";

                        <div class="v-card @cardCls"
                             data-name="@v.VehicleName.ToLower()"
                             data-reg="@v.RegistrationNo.ToLower()"
                             data-status="@(v.IsAvailable ? "avail" : "inuse")">

                            <div class="v-card-dot @dotCls"></div>
                            <div class="v-type-badge">@v.VehicleTypeName</div>
                            <div class="v-card-name">@v.VehicleName</div>
                            <div class="v-reg-tag">@v.RegistrationNo</div>
                            <hr class="v-divider" />

                            <div class="v-detail-row">
                                <span class="v-detail-label">Year</span>
                                <span class="v-detail-val">@v.YearOfManufacture</span>
                            </div>
                            <div class="v-detail-row">
                                <span class="v-detail-label">Status</span>
                                <span class="v-detail-val">
                                    @if (v.IsAvailable)
                                    {
                                        <span class="v-detail-val green">Available</span>
                                    }
                                    else
                                    {
                                        <span class="inuse-status-pill">
                                            <span class="inuse-status-dot"></span>In Use
                                        </span>
                                    }
                                </span>
                            </div>
                            <div class="v-detail-row">
                                <span class="v-detail-label">Notes</span>
                                <span class="v-detail-val notes">@notes</span>
                            </div>

                            @if (!v.IsAvailable && v.FreeAt.HasValue)
                            {
                                <div class="free-in-badge">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                                    Free in @v.FreeInLabel
                                    &nbsp;·&nbsp; @v.FreeAt.Value.ToString("dd MMM, hh:mm tt")
                                </div>
                            }

                            @* in-use vehicles now get an active schedule button ── *@
                            @if (v.IsAvailable)
                            {
                                <button class="v-request-btn btn-avail"
                                        onclick="openModal(@v.VehicleId, '@safeName', '@v.RegistrationNo', '@safeType', false, '')">
                                    + Request This Vehicle
                                </button>
                            }
                            else if (v.FreeAt.HasValue)
                            {
                                <button class="v-request-btn btn-schedule"
                                        onclick="openModal(@v.VehicleId, '@safeName', '@v.RegistrationNo', '@safeType', true, '@freeAtIso')">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                                    Schedule from @v.FreeAt.Value.ToString("hh:mm tt, dd MMM")
                                </button>
                            }
                            else
                            {
                                @* No FreeAt known — still let them request, starting now *@
                                <button class="v-request-btn btn-schedule"
                                        onclick="openModal(@v.VehicleId, '@safeName', '@v.RegistrationNo', '@safeType', true, '')">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                                    Request When Available
                                </button>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal-overlay" id="requestModal">
    <div class="modal">
        <div class="modal-header" id="modalHeader">
            <div class="modal-header-left">
                <span style="font-size:22px;" id="modalEmoji">🚗</span>
                <span class="modal-title" id="modalTitle">Request Vehicle</span>
            </div>
            <button class="modal-close" onclick="closeModal()">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
        </div>

        @*  warning banner shown only for in-use vehicles ── *@
        <div class="modal-inuse-notice" id="inuseNotice">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            <div class="modal-inuse-notice-text">
                <span>Vehicle currently in use</span>
                Your request will be scheduled to start from <strong id="noticeFromTime">—</strong>.
                The admin will review and approve based on availability.
            </div>
        </div>

        <div class="modal-vehicle-block">
            <div class="mvb-name" id="mv-name">—</div>
            <div class="mvb-tags">
                <span class="mvb-reg" id="mv-reg">—</span>
                <span class="mvb-type" id="mv-type">—</span>
            </div>
        </div>

        <div class="modal-body">
            @using (Html.BeginForm("SubmitRequest", "EmployeeDashboard", FormMethod.Post, new { id = "requestForm" }))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="VehicleId"      id="hVehicleId" />
                <input type="hidden" name="VehicleName"    id="hVehicleName" />
                <input type="hidden" name="RegistrationNo" id="hRegNo" />
                <input type="hidden" name="VehicleTypeName" id="hTypeName" />

                <div class="form-row-2">
                    <div class="form-group">
                        <label class="form-label">Start Date &amp; Time</label>
                        <input type="datetime-local" class="form-control" name="RequiredFrom"
                               id="dtFrom" required onchange="calcDuration()" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">End Date &amp; Time</label>
                        <input type="datetime-local" class="form-control" name="RequiredUntil"
                               id="dtUntil" required onchange="calcDuration()" />
                    </div>
                </div>

                <div class="duration-pill" id="durationPill">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                    <span id="durationText">Set dates to see duration</span>
                </div>

                <div class="form-group">
                    <label class="form-label">Purpose / Destination</label>
                    <textarea class="form-control" name="Purpose"
                              placeholder="e.g. Client visit to Chennai airport…" required></textarea>
                </div>

                <button type="submit" class="btn-submit" id="submitBtn">
                    Submit Request &rarr;
                </button>
            }
        </div>
    </div>
</div>

<script>
    // ── Filter tabs ──
    var tabs = document.querySelectorAll('.ftab');
    function filterCards(status) {
        tabs.forEach(function(t) {
            t.className = 'ftab';
            if ((status === 'all'   && t.textContent.trim() === 'All')       ||
                (status === 'avail' && t.textContent.trim() === 'Available') ||
                (status === 'inuse' && t.textContent.trim() === 'In Use')) {
                t.classList.add(status === 'all' ? 'f-all' : status === 'avail' ? 'f-avail' : 'f-inuse');
            }
        });
        document.querySelectorAll('.v-card').forEach(function(c) {
            var s = c.getAttribute('data-status');
            c.style.display = (status === 'all' || s === status) ? '' : 'none';
        });
    }

    // ── Live search ──
    function liveSearch(val) {
        val = val.toLowerCase().trim();
        document.querySelectorAll('.v-card').forEach(function(c) {
            var n = c.getAttribute('data-name');
            var r = c.getAttribute('data-reg');
            c.style.display = (!val || n.includes(val) || r.includes(val)) ? '' : 'none';
        });
    }

    function openModal(id, name, reg, type, isInUse, freeAtIso) {
        document.getElementById('hVehicleId').value  = id;
        document.getElementById('hVehicleName').value = name;
        document.getElementById('hRegNo').value       = reg;
        document.getElementById('hTypeName').value    = type;
        document.getElementById('mv-name').textContent = name;
        document.getElementById('mv-reg').textContent  = reg;
        document.getElementById('mv-type').textContent = type;

        var now = new Date(); now.setSeconds(0, 0);
        var fmt = function(d) {
            return d.getFullYear() + '-' + pad(d.getMonth()+1) + '-' + pad(d.getDate())
                 + 'T' + pad(d.getHours()) + ':' + pad(d.getMinutes());
        };

        var startDt, minDt;

        if (isInUse && freeAtIso) {
            // Start time locked to when the vehicle becomes free
            startDt = new Date(freeAtIso);
            minDt   = startDt;           // can't start before it's free
        } else {
            startDt = now;
            minDt   = now;
        }

        var endDt = new Date(startDt.getTime() + 2 * 3600000); // default +2 h

        document.getElementById('dtFrom').value = fmt(startDt);
        document.getElementById('dtFrom').min   = fmt(minDt);
        document.getElementById('dtUntil').value = fmt(endDt);
        document.getElementById('dtUntil').min   = fmt(minDt);

        // ── Toggle in-use notice banner + header colour ──
        var notice  = document.getElementById('inuseNotice');
        var header  = document.getElementById('modalHeader');
        var submitB = document.getElementById('submitBtn');
        var emoji   = document.getElementById('modalEmoji');
        var title   = document.getElementById('modalTitle');

        if (isInUse) {
            notice.classList.add('visible');
            header.classList.add('header-schedule');
            submitB.classList.add('btn-submit-schedule');
            emoji.textContent = '🕐';
            title.textContent = 'Schedule Vehicle Request';

            // Show human-readable free time in the notice
            var noticeTime = freeAtIso
                ? new Date(freeAtIso).toLocaleString('en-IN', { day:'2-digit', month:'short', hour:'2-digit', minute:'2-digit', hour12:true })
                : 'when it becomes available';
            document.getElementById('noticeFromTime').textContent = noticeTime;
        } else {
            notice.classList.remove('visible');
            header.classList.remove('header-schedule');
            submitB.classList.remove('btn-submit-schedule');
            emoji.textContent = '🚗';
            title.textContent = 'Request Vehicle';
        }

        calcDuration();
        document.getElementById('requestModal').classList.add('open');
        document.body.style.overflow = 'hidden';
    }

    function pad(n) { return n < 10 ? '0' + n : '' + n; }

    function closeModal() {
        document.getElementById('requestModal').classList.remove('open');
        document.body.style.overflow = '';
    }

    document.getElementById('requestModal').addEventListener('click', function(e) {
        if (e.target === this) closeModal();
    });

    function calcDuration() {
        var from  = new Date(document.getElementById('dtFrom').value);
        var until = new Date(document.getElementById('dtUntil').value);
        var txt   = document.getElementById('durationText');
        if (!isNaN(from) && !isNaN(until) && until > from) {
            var mins = Math.round((until - from) / 60000);
            var h = Math.floor(mins / 60), m = mins % 60;
            var label = '';
            if (h > 0) label += h + ' hour' + (h > 1 ? 's' : '');
            if (m > 0) label += (label ? ' ' : '') + m + ' min';
            txt.textContent = 'Duration: ' + label;
            document.getElementById('dtUntil').min = document.getElementById('dtFrom').value;
        } else {
            txt.textContent = 'End time must be after start time';
        }
    }

    document.getElementById('requestForm').addEventListener('submit', function() {
        var b = document.getElementById('submitBtn');
        b.disabled = true; b.textContent = 'Submitting…';
    });
</script>
</body>
</html>