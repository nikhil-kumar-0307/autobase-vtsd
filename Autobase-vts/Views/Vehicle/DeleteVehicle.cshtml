@model List<autobase.Models.Vehicle>
@{
    ViewBag.Title = "Delete Vehicle";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    /* ── Breadcrumb ── */
    .breadcrumb {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 12px;
        color: #bbb;
        margin-bottom: 18px;
        animation: fadeUp .3s ease both;
    }

        .breadcrumb a {
            color: #bbb;
            text-decoration: none;
        }

            .breadcrumb a:hover {
                color: #555;
            }

        .breadcrumb .sep {
            color: #ddd;
        }

        .breadcrumb .current {
            color: #555;
            font-weight: 600;
        }

    /* ── Hero ── */
    .hero-banner {
        background: linear-gradient(120deg, #1a2340 0%, #2a3a6e 60%, #1e2e55 100%);
        border-radius: 14px;
        padding: 28px 32px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 20px;
        position: relative;
        overflow: hidden;
        animation: fadeUp .35s ease .03s both;
    }

        .hero-banner::before {
            content: '';
            position: absolute;
            right: -40px;
            top: -40px;
            width: 200px;
            height: 200px;
            background: rgba(255,255,255,.04);
            border-radius: 50%;
        }

    .hero-left {
        display: flex;
        align-items: center;
        gap: 18px;
    }

    .hero-icon {
        width: 52px;
        height: 52px;
        background: rgba(229,62,62,.15);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .hero-eyebrow {
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: #F5C518;
        margin-bottom: 4px;
    }

    .hero-title {
        font-size: 26px;
        font-weight: 800;
        color: #fff;
        letter-spacing: -.3px;
    }

        .hero-title span {
            color: #fc8181;
        }

    .hero-sub {
        font-size: 13px;
        color: rgba(255,255,255,.5);
        margin-top: 4px;
    }

    .hero-badge {
        background: rgba(229,62,62,.18);
        color: #fc8181;
        border: 1px solid rgba(229,62,62,.3);
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 1px;
        padding: 8px 18px;
        border-radius: 8px;
        text-transform: uppercase;
    }

    /* ── Warning bar ── */
    .warn-bar {
        background: #fffbeb;
        border: 1.5px solid #fde68a;
        border-radius: 10px;
        padding: 13px 18px;
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 13px;
        color: #92400e;
        margin-bottom: 20px;
        animation: fadeUp .38s ease .05s both;
    }

        .warn-bar svg {
            flex-shrink: 0;
            color: #d97706;
        }

        .warn-bar strong {
            color: #b45309;
        }

    /* ── Table card ── */
    .table-card {
        background: #fff;
        border: 1px solid #efefef;
        border-radius: 14px;
        overflow: hidden;
        animation: fadeUp .4s ease .07s both;
    }

    .table-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 16px 22px;
        border-bottom: 1px solid #f5f5f5;
    }

    .table-title-wrap {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .table-title {
        font-size: 15px;
        font-weight: 700;
        color: #0d0d0d;
    }

    .table-count {
        font-size: 11px;
        color: #aaa;
        background: #f5f5f5;
        padding: 3px 10px;
        border-radius: 20px;
        font-weight: 600;
    }

    /* Search */
    .search-wrap {
        position: relative;
    }

        .search-wrap input {
            height: 38px;
            padding: 0 14px 0 36px;
            border: 1.5px solid #e8e8e8;
            border-radius: 9px;
            font-family: 'Barlow', sans-serif;
            font-size: 13px;
            color: #0d0d0d;
            background: #fafafa;
            outline: none;
            width: 220px;
            transition: border-color .2s, box-shadow .2s;
        }

            .search-wrap input:focus {
                border-color: #3182ce;
                background: #fff;
                box-shadow: 0 0 0 3px rgba(49,130,206,.12);
            }

    .search-icon {
        position: absolute;
        left: 11px;
        top: 50%;
        transform: translateY(-50%);
        color: #ccc;
        pointer-events: none;
    }

    /* ── Data table ── */
    .data-table {
        width: 100%;
        border-collapse: collapse;
    }

        .data-table thead tr {
            background: #fafafa;
            border-bottom: 1px solid #f0f0f0;
        }

        .data-table thead th {
            padding: 11px 18px;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 1.2px;
            text-transform: uppercase;
            color: #aaa;
            text-align: left;
        }

        .data-table tbody tr {
            border-bottom: 1px solid #f9f9f9;
            transition: background .15s;
        }

            .data-table tbody tr:last-child {
                border-bottom: none;
            }

            .data-table tbody tr:hover {
                background: #fff8f8;
            }

        .data-table td {
            padding: 14px 18px;
            font-size: 13px;
            color: #333;
        }

    .td-num {
        font-weight: 600;
        color: #bbb;
        font-size: 12px;
    }

    .td-name {
        font-weight: 700;
        color: #0d0d0d;
        font-size: 14px;
    }

    .td-reg {
        font-family: 'Courier New', monospace;
        font-size: 13px;
        font-weight: 600;
        color: #444;
    }

    /* status badge */
    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .3px;
    }

        .status-badge.available {
            background: #f0fdf4;
            color: #166534;
        }

        .status-badge.allocated {
            background: #fffbeb;
            color: #92400e;
        }

        .status-badge.maintenance {
            background: #fff5f5;
            color: #c53030;
        }

    .status-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
    }

        .status-dot.available {
            background: #38a169;
        }

        .status-dot.allocated {
            background: #d69e2e;
        }

        .status-dot.maintenance {
            background: #e53e3e;
        }

    /* Disable button */
    .btn-disable {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        height: 36px;
        padding: 0 16px;
        background: #fff;
        color: #e53e3e;
        font-family: 'Barlow', sans-serif;
        font-size: 12px;
        font-weight: 700;
        border: 1.5px solid #fed7d7;
        border-radius: 8px;
        cursor: pointer;
        text-decoration: none;
        transition: background .2s, border-color .2s, transform .1s;
    }

        .btn-disable:hover {
            background: #fff5f5;
            border-color: #e53e3e;
        }

        .btn-disable:active {
            transform: scale(.97);
        }

    /* alerts */
    .alert-success {
        background: #f0fdf4;
        border: 1.5px solid #bbf7d0;
        border-radius: 10px;
        padding: 12px 16px;
        font-size: 13px;
        font-weight: 500;
        color: #166534;
        margin-bottom: 16px;
        display: flex;
        align-items: center;
        gap: 9px;
        animation: fadeUp .3s ease both;
    }

    .alert-error {
        background: #fff5f5;
        border: 1.5px solid #fed7d7;
        border-radius: 10px;
        padding: 12px 16px;
        font-size: 13px;
        font-weight: 500;
        color: #c53030;
        margin-bottom: 16px;
    }

    /* empty state */
    .empty-state {
        text-align: center;
        padding: 60px 20px;
    }

        .empty-state svg {
            margin-bottom: 12px;
            opacity: .3;
        }

        .empty-state p {
            font-size: 14px;
            font-weight: 600;
            color: #ccc;
        }

    /* ── Confirm modal overlay ── */
    .modal-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,.45);
        backdrop-filter: blur(3px);
        z-index: 999;
        align-items: center;
        justify-content: center;
    }

        .modal-overlay.open {
            display: flex;
        }

    .modal-box {
        background: #fff;
        border-radius: 16px;
        width: 420px;
        max-width: 94vw;
        box-shadow: 0 20px 60px rgba(0,0,0,.2);
        animation: popIn .2s ease both;
    }

    .modal-header {
        padding: 22px 24px 16px;
        display: flex;
        align-items: flex-start;
        gap: 14px;
    }

    .modal-icon-wrap {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        background: #fff5f5;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .modal-title {
        font-size: 16px;
        font-weight: 800;
        color: #0d0d0d;
        margin-bottom: 4px;
    }

    .modal-subtitle {
        font-size: 13px;
        color: #888;
        line-height: 1.5;
    }

    .modal-vehicle-card {
        margin: 0 24px 20px;
        background: #fafafa;
        border: 1px solid #f0f0f0;
        border-radius: 10px;
        padding: 14px 16px;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
    }

    .mvc-row {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .mvc-key {
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 1px;
        text-transform: uppercase;
        color: #bbb;
    }

    .mvc-val {
        font-size: 13px;
        font-weight: 700;
        color: #0d0d0d;
    }

    .modal-footer {
        padding: 0 24px 22px;
        display: flex;
        gap: 10px;
        justify-content: flex-end;
    }

    .btn-modal-cancel {
        height: 40px;
        padding: 0 18px;
        background: #fff;
        color: #666;
        font-family: 'Barlow', sans-serif;
        font-size: 13px;
        font-weight: 600;
        border: 1.5px solid #e0e0e0;
        border-radius: 9px;
        cursor: pointer;
        transition: border-color .2s;
    }

        .btn-modal-cancel:hover {
            border-color: #aaa;
            color: #0d0d0d;
        }

    .btn-modal-confirm {
        height: 40px;
        padding: 0 22px;
        background: #e53e3e;
        color: #fff;
        font-family: 'Barlow', sans-serif;
        font-size: 13px;
        font-weight: 700;
        border: none;
        border-radius: 9px;
        cursor: pointer;
        box-shadow: 0 3px 10px rgba(229,62,62,.3);
        transition: background .2s, transform .1s;
    }

        .btn-modal-confirm:hover {
            background: #c53030;
        }

        .btn-modal-confirm:active {
            transform: scale(.97);
        }

    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes popIn {
        from {
            opacity: 0;
            transform: scale(.93);
        }

        to {
            opacity: 1;
            transform: scale(1);
        }
    }
</style>

<!-- Breadcrumb -->
<div class="breadcrumb">
    <a href="@Url.Action("Index","Dashboard")">Dashboard</a>
    <span class="sep">›</span>
    <span>Fleet</span>
    <span class="sep">›</span>
    <span class="current">Delete Vehicle</span>
</div>

<!-- Hero -->
<div class="hero-banner">
    <div class="hero-left">
        <div class="hero-icon">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#fc8181" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="3 6 5 6 21 6" />
                <path d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6" />
                <path d="M10 11v6" />
                <path d="M14 11v6" />
                <path d="M9 6V4a1 1 0 011-1h4a1 1 0 011 1v2" />
            </svg>
        </div>
        <div>
            <div class="hero-eyebrow">◆ Fleet Management</div>
            <div class="hero-title">Disable <span>Vehicle</span></div>
            <div class="hero-sub">Disabled vehicles are hidden from the fleet but not permanently deleted.</div>
        </div>
    </div>
    <div class="hero-badge">Soft Delete</div>
</div>

<!-- Warning bar -->
<div class="warn-bar">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10" />
        <line x1="12" y1="8" x2="12" y2="12" />
        <line x1="12" y1="16" x2="12.01" y2="16" />
    </svg>
    Disabling a vehicle hides it from all lists. The data is&nbsp;<strong>not deleted</strong>&nbsp;from the database and can be restored later.
</div>

<!-- Alerts -->
@if (TempData["Success"] != null)
{
    <div class="alert-success">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 11.08V12a10 10 0 11-5.93-9.14" />
            <polyline points="22 4 12 14.01 9 11.01" />
        </svg>
        @TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert-error">@TempData["Error"]</div>
}

<!-- Table Card -->
<div class="table-card">
    <div class="table-card-header">
        <div class="table-title-wrap">
            <span class="table-title">Active Vehicles</span>
            <span class="table-count">@Model.Count</span>
        </div>
        <div class="search-wrap">
            <span class="search-icon">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="8" />
                    <line x1="21" y1="21" x2="16.65" y2="16.65" />
                </svg>
            </span>
            <input type="text" placeholder="Search..." oninput="filterTable(this.value)" />
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#ccc" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="3 6 5 6 21 6" />
                <path d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6" />
                <path d="M9 6V4a1 1 0 011-1h4a1 1 0 011 1v2" />
            </svg>
            <p>No active vehicles in the fleet.</p>
        </div>
    }
    else
    {
        <table class="data-table" id="vehicleTable">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Vehicle Name</th>
                    <th>Reg. Number</th>
                    <th>Type</th>
                    <th>Year</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @{ int i = 1; }
                @foreach (var v in Model)
                {
                    string sc = v.Status?.ToLower() == "available" ? "available"
                              : v.Status?.ToLower() == "allocated" ? "allocated"
                              : "maintenance";
                    <tr>
                        <td class="td-num">@(i++)</td>
                        <td class="td-name">@v.VehicleName</td>
                        <td class="td-reg">@v.RegistrationNo</td>
                        <td>@v.VehicleType</td>
                        <td>@v.YearOfManufacture</td>
                        <td>
                            <span class="status-badge @sc">
                                <span class="status-dot @sc"></span>
                                @v.Status
                            </span>
                        </td>
                        <td>
                            <button type="button" class="btn-disable"
                                    onclick="openModal(@v.Id, '@v.VehicleName', '@v.RegistrationNo', '@v.VehicleType', @v.YearOfManufacture)">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="12" cy="12" r="10" />
                                    <line x1="4.93" y1="4.93" x2="19.07" y2="19.07" />
                                </svg>
                                Disable
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<!-- ── Confirm Modal ── -->
<div class="modal-overlay" id="confirmModal">
    <div class="modal-box">
        <div class="modal-header">
            <div class="modal-icon-wrap">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#e53e3e" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10" />
                    <line x1="4.93" y1="4.93" x2="19.07" y2="19.07" />
                </svg>
            </div>
            <div>
                <div class="modal-title">Disable this vehicle?</div>
                <div class="modal-subtitle">The vehicle will be hidden from all fleet lists.<br>This action can be undone by an administrator.</div>
            </div>
        </div>

        <!-- Vehicle summary card inside modal -->
        <div class="modal-vehicle-card">
            <div class="mvc-row">
                <span class="mvc-key">Vehicle Name</span>
                <span class="mvc-val" id="m-name">—</span>
            </div>
            <div class="mvc-row">
                <span class="mvc-key">Reg. Number</span>
                <span class="mvc-val" id="m-reg" style="font-family:'Courier New',monospace;">—</span>
            </div>
            <div class="mvc-row">
                <span class="mvc-key">Type</span>
                <span class="mvc-val" id="m-type">—</span>
            </div>
            <div class="mvc-row">
                <span class="mvc-key">Year</span>
                <span class="mvc-val" id="m-year">—</span>
            </div>
        </div>

        <div class="modal-footer">
            <button type="button" class="btn-modal-cancel" onclick="closeModal()">Cancel</button>
            @using (Html.BeginForm("Disable", "Vehicle", FormMethod.Post, new { id = "disableForm" }))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="disableId" value="" />
                <button type="submit" class="btn-modal-confirm">
                    Yes, Disable Vehicle
                </button>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function filterTable(q) {
            q = q.toLowerCase();
            document.querySelectorAll('#vehicleTable tbody tr').forEach(function(r) {
                r.style.display = r.textContent.toLowerCase().includes(q) ? '' : 'none';
            });
        }

        function openModal(id, name, reg, type, year) {
            document.getElementById('m-name').textContent = name;
            document.getElementById('m-reg').textContent  = reg;
            document.getElementById('m-type').textContent = type;
            document.getElementById('m-year').textContent = year;
            document.getElementById('disableId').value    = id;
            document.getElementById('confirmModal').classList.add('open');
        }

        function closeModal() {
            document.getElementById('confirmModal').classList.remove('open');
        }

        // Close on backdrop click
        document.getElementById('confirmModal').addEventListener('click', function(e) {
            if (e.target === this) closeModal();
        });
    </script>
}
