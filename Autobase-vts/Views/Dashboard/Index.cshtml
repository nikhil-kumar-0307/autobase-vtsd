@model autobase.Models.DTOs.AdminDashboardDto
@{
    ViewBag.Title = "Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    string role = Session["Role"]?.ToString() ?? "";
    string fullName = Session["FullName"]?.ToString() ?? "User";
    string empNo = Session["EmployeeNumber"]?.ToString() ?? "";

    // Fleet utilisation % for the ring
    int utilPct = Model.TotalVehicles > 0
        ? (int)((Model.Allocated * 100.0) / Model.TotalVehicles)
        : 0;
    int dashOffset = (int)(251.2 * (1 - utilPct / 100.0)); // circumference ≈ 251.2
}

<style>
    /* ── tokens ── */
    :root {
        --yellow:  #F5C518;
        --yellow2: #e6b800;
        --ink:     #0d0d0d;
        --muted:   #888;
        --border:  #efefef;
        --surface: #fff;
        --bg:      #f7f7f7;
        --green:   #16a34a;
        --blue:    #2563eb;
        --amber:   #d97706;
        --red:     #dc2626;
        --purple:  #7c3aed;
    }

    /* ── welcome ── */
    .welcome-banner {
        background: linear-gradient(135deg, #fffbea 0%, #fff3cc 100%);
        border: 1px solid #f5e090;
        border-radius: 16px;
        padding: 22px 28px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 22px;
        animation: fadeUp .35s ease both;
    }
    .welcome-title { font-size: 21px; font-weight: 800; color: var(--ink); letter-spacing: -.3px; }
    .welcome-sub   { font-size: 13px; color: var(--muted); margin-top: 3px; }
    .welcome-sub span { font-weight: 700; color: var(--ink); }
    .role-badge {
        background: var(--yellow); color: var(--ink);
        font-size: 11px; font-weight: 800; padding: 6px 16px;
        border-radius: 50px; letter-spacing: .5px; text-transform: uppercase;
    }

    /* ── top row: 4 stat cards + utilisation ring ── */
    .top-row {
        display: grid;
        grid-template-columns: repeat(4,1fr) 200px;
        gap: 16px;
        margin-bottom: 20px;
        animation: fadeUp .4s ease .04s both;
    }
    .stat-card {
        background: var(--surface); border: 1px solid var(--border);
        border-radius: 14px; padding: 20px 22px;
        position: relative; overflow: hidden;
        transition: box-shadow .2s, transform .15s;
    }
    .stat-card:hover { box-shadow: 0 6px 20px rgba(0,0,0,.07); transform: translateY(-2px); }
    .stat-card::after {
        content: ''; position: absolute; bottom: 0; left: 0; right: 0; height: 3px;
    }
    .stat-card.yellow::after { background: var(--yellow); }
    .stat-card.green::after  { background: var(--green);  }
    .stat-card.blue::after   { background: var(--blue);   }
    .stat-card.purple::after { background: var(--purple); }
    .stat-card.red::after    { background: var(--red);    }

    .stat-icon {
        width: 38px; height: 38px; border-radius: 10px;
        display: flex; align-items: center; justify-content: center;
        margin-bottom: 14px; font-size: 18px;
    }
    .stat-icon.yellow { background: #fff8dc; color: #c9a000; }
    .stat-icon.green  { background: #dcfce7; color: var(--green); }
    .stat-icon.blue   { background: #dbeafe; color: var(--blue);  }
    .stat-icon.purple { background: #ede9fe; color: var(--purple);}
    .stat-icon.red    { background: #fee2e2; color: var(--red);   }

    .stat-number { font-size: 34px; font-weight: 800; color: var(--ink); line-height: 1; }
    .stat-label  { font-size: 10px; font-weight: 700; letter-spacing: 1.2px; text-transform: uppercase; color: #aaa; margin-top: 5px; }
    .stat-delta  { font-size: 11px; color: var(--green); font-weight: 700; margin-top: 6px; }

    /* utilisation ring card */
    .ring-card {
        background: var(--ink); border-radius: 14px;
        padding: 20px; display: flex; flex-direction: column;
        align-items: center; justify-content: center; gap: 10px;
        transition: box-shadow .2s;
    }
    .ring-card:hover { box-shadow: 0 6px 20px rgba(0,0,0,.25); }
    .ring-wrap { position: relative; width: 90px; height: 90px; }
    .ring-wrap svg { transform: rotate(-90deg); }
    .ring-bg   { fill: none; stroke: rgba(255,255,255,.12); stroke-width: 8; }
    .ring-fill {
        fill: none; stroke: var(--yellow); stroke-width: 8;
        stroke-linecap: round;
        stroke-dasharray: 251.2;
        stroke-dashoffset: @dashOffset;
        transition: stroke-dashoffset 1.2s cubic-bezier(.4,0,.2,1);
    }
    .ring-pct {
        position: absolute; inset: 0;
        display: flex; align-items: center; justify-content: center;
        font-size: 18px; font-weight: 800; color: #fff;
    }
    .ring-label { font-size: 10px; font-weight: 700; letter-spacing: 1.2px; text-transform: uppercase; color: rgba(255,255,255,.5); }
    .ring-sub   { font-size: 12px; color: rgba(255,255,255,.7); font-weight: 600; text-align: center; line-height: 1.4; }

    /* ── request + user stats row ── */
    .mid-row {
        display: grid;
        grid-template-columns: repeat(5,1fr);
        gap: 14px;
        margin-bottom: 20px;
        animation: fadeUp .45s ease .08s both;
    }
    .mini-stat {
        background: var(--surface); border: 1px solid var(--border);
        border-radius: 12px; padding: 16px 18px;
    }
    .mini-stat .ms-lbl { font-size: 9px; font-weight: 700; letter-spacing: 1.3px; text-transform: uppercase; color: #ccc; margin-bottom: 7px; }
    .mini-stat .ms-num { font-size: 26px; font-weight: 800; color: var(--ink); line-height: 1; }
    .mini-stat .ms-sub { font-size: 11px; color: #bbb; margin-top: 4px; }

    /* ── quick actions ── */
    .qa-section { margin-bottom: 20px; animation: fadeUp .5s ease .1s both; }
    .section-hdr {
        font-size: 11px; font-weight: 700; letter-spacing: 1.4px;
        text-transform: uppercase; color: #bbb;
        display: flex; align-items: center; gap: 8px;
        margin-bottom: 12px;
    }
    .section-hdr::after { content: ''; flex: 1; height: 1px; background: var(--border); }

    .qa-grid { display: grid; grid-template-columns: repeat(4,1fr); gap: 12px; }
    .qa-card {
        background: var(--surface); border: 1px solid var(--border);
        border-radius: 12px; padding: 16px;
        display: flex; align-items: center; gap: 12px;
        text-decoration: none; color: inherit;
        transition: border-color .18s, box-shadow .18s, transform .12s;
    }
    .qa-card:hover { border-color: var(--yellow); box-shadow: 0 4px 16px rgba(245,197,24,.18); transform: translateY(-2px); }
    .qa-icon {
        width: 38px; height: 38px; border-radius: 10px;
        background: #fff8dc; border: 1px solid #f5e090;
        display: flex; align-items: center; justify-content: center;
        color: #c9a000; flex-shrink: 0;
    }
    .qa-label { font-size: 13px; font-weight: 700; color: var(--ink); }
    .qa-sub   { font-size: 11px; color: #aaa; margin-top: 1px; }

    /* ── bottom grid ── */
    .bottom-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 18px;
        margin-bottom: 20px;
        animation: fadeUp .55s ease .12s both;
    }
    .data-card { background: var(--surface); border: 1px solid var(--border); border-radius: 14px; overflow: hidden; }
    .dc-header {
        padding: 14px 18px; border-bottom: 1px solid #f5f5f5;
        display: flex; align-items: center; justify-content: space-between;
    }
    .dc-title {
        font-size: 13px; font-weight: 700; color: var(--ink);
        display: flex; align-items: center; gap: 7px;
    }
    .dc-title svg { color: var(--yellow); }
    .view-all {
        font-size: 11.5px; font-weight: 700; color: var(--yellow);
        text-decoration: none; display: flex; align-items: center; gap: 4px;
    }
    .view-all:hover { color: var(--yellow2); }

    .dt { width: 100%; border-collapse: collapse; }
    .dt th {
        font-size: 8.5px; font-weight: 700; letter-spacing: 1.2px; text-transform: uppercase;
        color: #bbb; padding: 9px 18px; text-align: left;
        background: #fafafa; border-bottom: 1px solid #f0f0f0;
    }
    .dt td { padding: 11px 18px; font-size: 12.5px; color: #555; border-bottom: 1px solid #f9f9f9; vertical-align: middle; }
    .dt tr:last-child td { border-bottom: none; }
    .dt tr:hover td { background: #fdfdfd; }

    .empty-state { padding: 36px; text-align: center; color: #ccc; font-size: 13px; }

    /* user avatar */
    .u-av {
        width: 30px; height: 30px; border-radius: 50%;
        background: var(--yellow); display: flex; align-items: center; justify-content: center;
        font-size: 11px; font-weight: 800; color: var(--ink); flex-shrink: 0;
    }
    .u-cell  { display: flex; align-items: center; gap: 9px; }
    .u-name  { font-size: 13px; font-weight: 700; color: var(--ink); }
    .u-dept  { font-size: 11px; color: #aaa; }

    /* role tag */
    .rtag {
        display: inline-block; font-size: 9.5px; font-weight: 700;
        padding: 3px 9px; border-radius: 50px; letter-spacing: .3px;
    }
    .rtag.superadmin { background: #fef9c3; color: #a16207; border: 1px solid #fde68a; }
    .rtag.admin      { background: #dbeafe; color: #1d4ed8; border: 1px solid #bfdbfe; }
    .rtag.employee   { background: #dcfce7; color: #166534; border: 1px solid #bbf7d0; }

    /* status pill */
    .spill {
        display: inline-flex; align-items: center; gap: 5px;
        padding: 3px 10px; border-radius: 50px;
        font-size: 10.5px; font-weight: 700;
    }
    .sdot { width: 6px; height: 6px; border-radius: 50%; }
    .spill.available  { background: #dcfce7; color: #166534; border: 1px solid #bbf7d0; }
    .sdot.available   { background: var(--green); }
    .spill.allocated  { background: #fef9c3; color: #a16207; border: 1px solid #fde68a; }
    .sdot.allocated   { background: var(--amber); }
    .spill.maintenance{ background: #fee2e2; color: #991b1b; border: 1px solid #fecaca; }
    .sdot.maintenance { background: var(--red); }
    .spill.pending    { background: #fef9c3; color: #a16207; border: 1px solid #fde68a; }
    .sdot.pending     { background: var(--amber); }
    .spill.approved   { background: #dcfce7; color: #166534; border: 1px solid #bbf7d0; }
    .sdot.approved    { background: var(--green); }
    .spill.rejected   { background: #fee2e2; color: #991b1b; border: 1px solid #fecaca; }
    .sdot.rejected    { background: var(--red); }
    .spill.returned   { background: #dbeafe; color: #1d4ed8; border: 1px solid #bfdbfe; }
    .sdot.returned    { background: var(--blue); }

    /* recent requests card full-width */
    .req-section { animation: fadeUp .6s ease .16s both; }

    /* overdue flag */
    .overdue-tag {
        display: inline-flex; align-items: center; gap: 3px;
        font-size: 9.5px; font-weight: 700;
        background: #fff1f1; color: var(--red);
        border: 1px solid #fecaca; padding: 2px 7px; border-radius: 4px; margin-left: 6px;
    }

    /* reg tag */
    .reg-tag {
        display: inline-block; font-size: 11px; font-weight: 700;
        padding: 3px 8px; border-radius: 5px;
        background: #f5f5f5; color: #555; border: 1px solid #eee;
        font-family: 'Courier New', monospace;
    }

    @@keyframes fadeUp {
        from { opacity: 0; transform: translateY(12px); }
        to   { opacity: 1; transform: translateY(0);    }
    }
</style>

<!-- ── Welcome banner ── -->
<div class="welcome-banner">
    <div>
        <div class="welcome-title">Welcome back, @fullName 👋</div>
        <div class="welcome-sub">
            Here's your fleet overview for today. &nbsp;|&nbsp; Emp No: <span>#@empNo</span>
        </div>
    </div>
    <div class="role-badge">@role</div>
</div>

<!-- ── Top row: fleet stats + utilisation ring ── -->
<div class="top-row">
    <div class="stat-card yellow">
        <div class="stat-icon yellow">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="1" y="3" width="15" height="13" rx="1" />
                <path d="M16 8h4l3 4v3h-7V8z" />
                <circle cx="5.5" cy="18.5" r="2.5" />
                <circle cx="18.5" cy="18.5" r="2.5" />
            </svg>
        </div>
        <div class="stat-number">@Model.TotalVehicles</div>
        <div class="stat-label">Total Vehicles</div>
        <div class="stat-delta">Fleet size</div>
    </div>

    <div class="stat-card green">
        <div class="stat-icon green">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 11.08V12a10 10 0 11-5.93-9.14" />
                <polyline points="22 4 12 14.01 9 11.01" />
            </svg>
        </div>
        <div class="stat-number">@Model.Available</div>
        <div class="stat-label">Available</div>
        <div class="stat-delta">Ready to deploy</div>
    </div>

    <div class="stat-card blue">
        <div class="stat-icon blue">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z" />
                <circle cx="12" cy="10" r="3" />
            </svg>
        </div>
        <div class="stat-number">@Model.Allocated</div>
        <div class="stat-label">Allocated</div>
        <div class="stat-delta">On active trips</div>
    </div>

    <div class="stat-card red">
        <div class="stat-icon red">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z" />
            </svg>
        </div>
        <div class="stat-number">@Model.Maintenance</div>
        <div class="stat-label">Maintenance</div>
        <div class="stat-delta">Under repair</div>
    </div>

    <!-- Utilisation ring -->
    <div class="ring-card">
        <div class="ring-wrap">
            <svg viewBox="0 0 90 90" width="90" height="90">
                <circle class="ring-bg" cx="45" cy="45" r="40" />
                <circle class="ring-fill" cx="45" cy="45" r="40" />
            </svg>
            <div class="ring-pct">@utilPct%</div>
        </div>
        <div class="ring-label">Utilisation</div>
        <div class="ring-sub">@Model.Allocated of @Model.TotalVehicles<br>vehicles active</div>
    </div>
</div>

<!-- ── Mid row: request counts ── -->
<div class="mid-row">
    <div class="mini-stat">
        <div class="ms-lbl">Total Requests</div>
        <div class="ms-num">@Model.TotalRequests</div>
        <div class="ms-sub">All time</div>
    </div>
    <div class="mini-stat">
        <div class="ms-lbl">Pending</div>
        <div class="ms-num" style="color:var(--amber);">@Model.PendingRequests</div>
        <div class="ms-sub">Awaiting action</div>
    </div>
    <div class="mini-stat">
        <div class="ms-lbl">Approved</div>
        <div class="ms-num" style="color:var(--green);">@Model.ApprovedRequests</div>
        <div class="ms-sub">Active bookings</div>
    </div>
    <div class="mini-stat">
        <div class="ms-lbl">Rejected</div>
        <div class="ms-num" style="color:var(--red);">@Model.RejectedRequests</div>
        <div class="ms-sub">Declined</div>
    </div>
    <div class="mini-stat">
        <div class="ms-lbl">Completed</div>
        <div class="ms-num" style="color:var(--blue);">@Model.CompletedRequests</div>
        <div class="ms-sub">Returned</div>
    </div>
</div>

<!-- ── Quick Actions ── -->
<div class="qa-section">
    <div class="section-hdr">⚡ Quick Actions</div>
    <div class="qa-grid">
        <a href="@Url.Action("Add","Vehicle")" class="qa-card">
            <div class="qa-icon">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10" />
                    <line x1="12" y1="8" x2="12" y2="16" />
                    <line x1="8" y1="12" x2="16" y2="12" />
                </svg>
            </div>
            <div><div class="qa-label">Add Vehicle</div><div class="qa-sub">Register new vehicle</div></div>
        </a>
        <a href="@Url.Action("EditIndex","Vehicle")" class="qa-card">
            <div class="qa-icon">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7" />
                    <path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z" />
                </svg>
            </div>
            <div><div class="qa-label">Edit Vehicle</div><div class="qa-sub">Update vehicle details</div></div>
        </a>
        <a href="@Url.Action("Add","User")" class="qa-card">
            <div class="qa-icon">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2" />
                    <circle cx="12" cy="7" r="4" />
                    <line x1="19" y1="8" x2="19" y2="14" />
                    <line x1="22" y1="11" x2="16" y2="11" />
                </svg>
            </div>
            <div><div class="qa-label">Add User</div><div class="qa-sub">Register employee</div></div>
        </a>
        <a href="@Url.Action("SeeRequests","Autobase")" class="qa-card">
            <div class="qa-icon">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z" />
                    <polyline points="14 2 14 8 20 8" />
                    <line x1="16" y1="13" x2="8" y2="13" />
                    <line x1="16" y1="17" x2="8" y2="17" />
                </svg>
            </div>
            <div>
                <div class="qa-label">See Requests</div>
                <div class="qa-sub">
                    @if (Model.PendingRequests > 0)
                    {
                        <span style="color:var(--amber);font-weight:700;">@Model.PendingRequests pending</span>
                    }
                    else
                    {
                        <span>All clear</span>
                    }
                </div>
            </div>
        </a>
    </div>
</div>

<!-- ── Bottom grid: vehicles + users ── -->
<div class="bottom-grid">

    <!-- Recent Vehicles -->
    <div class="data-card">
        <div class="dc-header">
            <div class="dc-title">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="1" y="3" width="15" height="13" rx="1" />
                    <path d="M16 8h4l3 4v3h-7V8z" />
                    <circle cx="5.5" cy="18.5" r="2.5" />
                    <circle cx="18.5" cy="18.5" r="2.5" />
                </svg>
                Recent Vehicles
            </div>
            <a href="@Url.Action("Index","Vehicle")" class="view-all">
                View all
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12" />
                    <polyline points="12 5 19 12 12 19" />
                </svg>
            </a>
        </div>
        <table class="dt">
            <thead>
                <tr>
                    <th>Vehicle</th>
                    <th>Reg No.</th>
                    <th>Year</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.RecentVehicles.Any())
                {
                    <tr><td colspan="4" class="empty-state">No vehicles registered yet.</td></tr>
                }
                else
                {
                    foreach (var v in Model.RecentVehicles)
                    {
                        string sc = v.Status?.ToLower() ?? "available";
                        <tr>
                            <td>
                                <div style="font-size:13px;font-weight:700;color:var(--ink);">@v.VehicleName</div>
                                <div style="font-size:11px;color:#aaa;">@v.VehicleType</div>
                            </td>
                            <td><span class="reg-tag">@v.RegistrationNo</span></td>
                            <td style="color:#888;">@v.YearOfManufacture</td>
                            <td>
                                <span class="spill @sc">
                                    <span class="sdot @sc"></span>
                                    @v.Status
                                </span>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- Recent Users -->
    <div class="data-card">
        <div class="dc-header">
            <div class="dc-title">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2" />
                    <circle cx="9" cy="7" r="4" />
                    <path d="M23 21v-2a4 4 0 00-3-3.87" />
                    <path d="M16 3.13a4 4 0 010 7.75" />
                </svg>
                Recent Users
            </div>
            <a href="@Url.Action("Index","User")" class="view-all">
                View all
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12" />
                    <polyline points="12 5 19 12 12 19" />
                </svg>
            </a>
        </div>
        <table class="dt">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Emp No.</th>
                    <th>Role</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.RecentUsers.Any())
                {
                    <tr><td colspan="3" class="empty-state">No users found.</td></tr>
                }
                else
                {
                    foreach (var u in Model.RecentUsers)
                    {
                        string initials = string.IsNullOrEmpty(u.FullName) ? "U"
                            : string.Join("", u.FullName.Split(' ')
                                .Where(w => w.Length > 0).Take(2)
                                .Select(w => w[0].ToString().ToUpper()));
                        string rtClass = u.Role?.ToLower() == "superadmin" ? "superadmin"
                                       : u.Role?.ToLower() == "admin" ? "admin"
                                       : "employee";
                        <tr>
                            <td>
                                <div class="u-cell">
                                    <div class="u-av">@initials</div>
                                    <div>
                                        <div class="u-name">@u.FullName</div>
                                        <div class="u-dept">@u.Designation &middot; @u.Department</div>
                                    </div>
                                </div>
                            </td>
                            <td style="color:#888;font-size:12px;">#@u.EmployeeNumber</td>
                            <td><span class="rtag @rtClass">@u.Role</span></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- ── Recent Requests (full width) ── -->
<div class="req-section">
    <div class="data-card">
        <div class="dc-header">
            <div class="dc-title">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z" />
                    <polyline points="14 2 14 8 20 8" />
                </svg>
                Recent Requests
            </div>
            <a href="@Url.Action("SeeRequests","Autobase")" class="view-all">
                View all
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12" />
                    <polyline points="12 5 19 12 12 19" />
                </svg>
            </a>
        </div>
        <table class="dt">
            <thead>
                <tr>
                    <th>Employee</th>
                    <th>Vehicle</th>
                    <th>Reg No.</th>
                    <th>From</th>
                    <th>Until</th>
                    <th>Purpose</th>
                    <th>Requested On</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.RecentRequests.Any())
                {
                    <tr><td colspan="8" class="empty-state">No requests yet.</td></tr>
                }
                else
                {
                    foreach (var r in Model.RecentRequests)
                    {
                        string sc = r.Status == "Approved" ? "approved"
                                  : r.Status == "Rejected" ? "rejected"
                                  : r.Status == "Returned" ? "returned"
                                  : "pending";

                        string empInit = string.IsNullOrEmpty(r.EmployeeName) ? "E"
                            : string.Join("", r.EmployeeName.Split(' ')
                                .Where(w => w.Length > 0).Take(2)
                                .Select(w => w[0].ToString().ToUpper()));

                        <tr>
                            <td>
                                <div class="u-cell">
                                    <div class="u-av" style="width:28px;height:28px;font-size:10px;">@empInit</div>
                                    <div>
                                        <div class="u-name" style="font-size:12.5px;">@r.EmployeeName</div>
                                        <div class="u-dept">#@r.EmployeeNumber</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span style="font-size:12.5px;font-weight:700;color:var(--ink);">@r.VehicleName</span>
                                @if (r.IsOverdue)
                                {
                                    <span class="overdue-tag">⚠ Overdue</span>
                                }
                            </td>
                            <td><span class="reg-tag">@r.RegistrationNo</span></td>
                            <td>
                                <div style="font-size:12.5px;font-weight:600;color:var(--ink);">@r.RequiredFrom.ToString("dd MMM yy")</div>
                                <div style="font-size:11px;color:#bbb;">@r.RequiredFrom.ToString("hh:mm tt")</div>
                            </td>
                            <td>
                                <div style="font-size:12.5px;font-weight:600;color:var(--ink);">@r.RequiredUntil.ToString("dd MMM yy")</div>
                                <div style="font-size:11px;color:#bbb;">@r.RequiredUntil.ToString("hh:mm tt")</div>
                            </td>
                            <td style="max-width:120px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;" title="@r.Purpose">
                                @r.Purpose
                            </td>
                            <td>
                                <div style="font-size:12px;color:#888;">@r.RequestedOn.ToString("dd MMM yy, hh:mm tt")</div>
                            </td>
                            <td>
                                <span class="spill @sc">
                                    <span class="sdot @sc"></span>
                                    @r.Status
                                </span>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>