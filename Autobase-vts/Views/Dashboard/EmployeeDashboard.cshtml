@{
    ViewBag.Title = "My Dashboard";
    Layout = null;

    string fullName = Session["FullName"]?.ToString() ?? "Employee";
    string empNo = Session["EmployeeNumber"]?.ToString() ?? "";
    string initials = string.IsNullOrEmpty(fullName) ? "E" : fullName.Substring(0, 1).ToUpper();

    var now = DateTime.Now;
    int hour = now.Hour;
    string greeting = hour < 12 ? "Good morning" : hour < 17 ? "Good afternoon" : "Good evening";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>AutoBase &mdash; Employee Dashboard</title>
    <link href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600;700;800&family=Barlow+Condensed:wght@700;800&display=swap" rel="stylesheet" />
    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Barlow', sans-serif;
            background: #f8f8f8;
            color: #0d0d0d;
            min-height: 100vh;
        }

        .emp-layout {
            display: flex;
            min-height: 100vh;
        }

        /* ── Sidebar ── */
        .emp-sidebar {
            width: 200px;
            min-width: 200px;
            background: #fff;
            border-right: 1px solid #f0f0f0;
            display: flex;
            flex-direction: column;
            height: 100vh;
            position: fixed;
            left: 0;
            top: 0;
            z-index: 100;
        }

        .emp-logo {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 20px 16px 16px;
            border-bottom: 1px solid #f5f5f5;
        }

        .emp-logo-icon {
            width: 32px;
            height: 32px;
            background: #F5C518;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .emp-logo-icon svg {
                width: 20px;
                height: 20px;
            }

        .emp-logo-text {
            font-family: 'Barlow Condensed', sans-serif;
            font-size: 17px;
            font-weight: 800;
            letter-spacing: 1px;
            color: #0d0d0d;
        }

        .logo-y {
            color: #F5C518;
        }

        .emp-nav {
            flex: 1;
            padding: 12px 10px;
            display: flex;
            flex-direction: column;
            gap: 1px;
        }

        .nav-label {
            font-size: 9px;
            font-weight: 700;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            color: #bbb;
            padding: 10px 8px 4px;
            margin-top: 4px;
        }

        .nav-link {
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 8px 10px;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 500;
            color: #555;
            text-decoration: none;
            transition: background .15s, color .15s;
        }

            .nav-link svg {
                flex-shrink: 0;
                opacity: .7;
            }

            .nav-link:hover {
                background: #f7f7f7;
                color: #0d0d0d;
            }

                .nav-link:hover svg {
                    opacity: 1;
                }

            .nav-link.active {
                background: #fff8dc;
                color: #0d0d0d;
                font-weight: 600;
            }

                .nav-link.active svg {
                    opacity: 1;
                    color: #c9a000;
                }

        .emp-sidebar-footer {
            padding: 14px;
            border-top: 1px solid #f0f0f0;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .emp-s-avatar {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            background: #F5C518;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
            font-weight: 700;
            color: #0d0d0d;
            flex-shrink: 0;
        }

        .emp-s-info {
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        .emp-s-name {
            font-size: 12px;
            font-weight: 600;
            color: #0d0d0d;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .emp-s-meta {
            font-size: 10px;
            color: #999;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        /* ── Topbar ── */
        .emp-topbar {
            height: 60px;
            background: #fff;
            border-bottom: 1px solid #f0f0f0;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 28px;
            position: fixed;
            top: 0;
            left: 200px;
            right: 0;
            z-index: 99;
        }

        .topbar-greet {
            font-size: 14px;
            font-weight: 600;
            color: #0d0d0d;
        }

        .topbar-sub {
            font-size: 12px;
            color: #aaa;
            margin-top: 1px;
        }

        .topbar-right {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .user-pill {
            display: flex;
            align-items: center;
            gap: 9px;
            background: #f7f7f7;
            border: 1px solid #ebebeb;
            border-radius: 50px;
            padding: 5px 12px 5px 5px;
        }

        .pill-avatar {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            background: #F5C518;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 13px;
            font-weight: 700;
            color: #0d0d0d;
        }

        .pill-name {
            font-size: 12px;
            font-weight: 600;
            color: #0d0d0d;
        }

        .pill-role {
            font-size: 10px;
            color: #999;
        }

        .logout-btn {
            display: flex;
            align-items: center;
            gap: 7px;
            padding: 8px 16px;
            border: 1.5px solid #eee;
            border-radius: 8px;
            font-family: 'Barlow', sans-serif;
            font-size: 13px;
            font-weight: 600;
            color: #555;
            text-decoration: none;
            background: #fff;
            transition: border-color .2s, color .2s, background .2s;
        }

            .logout-btn:hover {
                border-color: #e53e3e;
                color: #e53e3e;
                background: #fff5f5;
            }

        /* ── Main ── */
        .emp-main {
            margin-left: 200px;
            padding-top: 60px;
            flex: 1;
        }

        .emp-body {
            padding: 28px;
        }

        /* ── Welcome ── */
        .emp-welcome {
            background: linear-gradient(135deg, #fffbea 0%, #fff8d6 100%);
            border: 1px solid #f5e090;
            border-radius: 14px;
            padding: 24px 28px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 24px;
            animation: fadeUp .4s ease both;
        }

        .emp-welcome-title {
            font-size: 22px;
            font-weight: 800;
            color: #0d0d0d;
        }

        .emp-welcome-sub {
            font-size: 13px;
            color: #888;
            margin-top: 4px;
        }

            .emp-welcome-sub span {
                font-weight: 700;
                color: #0d0d0d;
            }

        .emp-badge {
            background: #0d0d0d;
            color: #F5C518;
            font-size: 12px;
            font-weight: 700;
            padding: 6px 16px;
            border-radius: 50px;
            letter-spacing: .3px;
        }

        /* ── Stats ── */
        .emp-stats {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 16px;
            margin-bottom: 28px;
            animation: fadeUp .45s ease .05s both;
        }

        .emp-stat {
            background: #fff;
            border: 1px solid #f0f0f0;
            border-radius: 14px;
            padding: 20px 22px;
            position: relative;
            overflow: hidden;
        }

            .emp-stat::before {
                content: '';
                position: absolute;
                bottom: 0;
                left: 0;
                right: 0;
                height: 3px;
            }

            .emp-stat.s1::before {
                background: #F5C518;
            }

            .emp-stat.s2::before {
                background: #38a169;
            }

            .emp-stat.s3::before {
                background: #e53e3e;
            }

        .emp-stat-icon {
            width: 36px;
            height: 36px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 14px;
        }

            .emp-stat-icon.y {
                background: #fff8dc;
                color: #c9a000;
            }

            .emp-stat-icon.g {
                background: #f0fff4;
                color: #38a169;
            }

            .emp-stat-icon.r {
                background: #fff5f5;
                color: #e53e3e;
            }

        .emp-stat-num {
            font-size: 32px;
            font-weight: 800;
            color: #0d0d0d;
        }

        .emp-stat-lbl {
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 1.2px;
            text-transform: uppercase;
            color: #aaa;
            margin-top: 5px;
        }

        /* ── Sections ── */
        .emp-bottom-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            animation: fadeUp .5s ease .1s both;
        }

        .emp-card {
            background: #fff;
            border: 1px solid #f0f0f0;
            border-radius: 14px;
            overflow: hidden;
        }

        .emp-card-header {
            padding: 16px 20px;
            border-bottom: 1px solid #f5f5f5;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .emp-card-title {
            font-size: 14px;
            font-weight: 700;
            color: #0d0d0d;
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .emp-card-title svg {
                color: #F5C518;
            }

        .emp-table {
            width: 100%;
            border-collapse: collapse;
        }

            .emp-table th {
                font-size: 9px;
                font-weight: 700;
                letter-spacing: 1.2px;
                text-transform: uppercase;
                color: #bbb;
                padding: 10px 20px;
                text-align: left;
                border-bottom: 1px solid #f5f5f5;
                background: #fafafa;
            }

            .emp-table td {
                padding: 12px 20px;
                font-size: 13px;
                color: #444;
                border-bottom: 1px solid #f9f9f9;
            }

            .emp-table tr:last-child td {
                border-bottom: none;
            }

        .empty-state {
            padding: 36px 20px;
            text-align: center;
            color: #bbb;
            font-size: 13px;
        }

        .status-badge {
            display: inline-block;
            font-size: 10px;
            font-weight: 700;
            padding: 3px 10px;
            border-radius: 50px;
            letter-spacing: .3px;
        }

            .status-badge.pending {
                background: #fef9c3;
                color: #a16207;
                border: 1px solid #fde68a;
            }

            .status-badge.approved {
                background: #dcfce7;
                color: #166534;
                border: 1px solid #bbf7d0;
            }

            .status-badge.rejected {
                background: #fee2e2;
                color: #991b1b;
                border: 1px solid #fecaca;
            }

        /* ── Request form card ── */
        .req-card {
            background: #fff;
            border: 1px solid #f0f0f0;
            border-radius: 14px;
            padding: 24px;
            margin-bottom: 20px;
            animation: fadeUp .45s ease .08s both;
        }

        .req-card-title {
            font-size: 15px;
            font-weight: 700;
            color: #0d0d0d;
            margin-bottom: 16px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .req-card-title svg {
                color: #F5C518;
            }

        .req-form {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
        }

        .req-field {
            display: flex;
            flex-direction: column;
            gap: 6px;
            flex: 1;
            min-width: 160px;
        }

            .req-field label {
                font-size: 10px;
                font-weight: 700;
                letter-spacing: 1.2px;
                text-transform: uppercase;
                color: #888;
            }

            .req-field input, .req-field select, .req-field textarea {
                padding: 10px 14px;
                border: 1.5px solid #eee;
                border-radius: 8px;
                font-family: 'Barlow', sans-serif;
                font-size: 13px;
                font-weight: 500;
                color: #0d0d0d;
                background: #fafafa;
                outline: none;
                transition: border-color .2s, background .2s;
            }

                .req-field input:focus, .req-field select:focus, .req-field textarea:focus {
                    border-color: #F5C518;
                    background: #fff;
                    box-shadow: 0 0 0 3px rgba(245,197,24,.15);
                }

        .req-submit {
            align-self: flex-end;
            height: 42px;
            padding: 0 24px;
            background: #F5C518;
            color: #0d0d0d;
            font-family: 'Barlow', sans-serif;
            font-size: 13px;
            font-weight: 700;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            transition: background .2s, box-shadow .2s;
            box-shadow: 0 3px 10px rgba(245,197,24,.3);
            white-space: nowrap;
        }

            .req-submit:hover {
                background: #d4a800;
                box-shadow: 0 5px 16px rgba(245,197,24,.4);
            }

        @@keyframes fadeUp {
            from {
                opacity: 0;
                transform: translateY(12px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
    </style>
</head>
<body>
    <div class="emp-layout">

        <!-- Sidebar -->
        <aside class="emp-sidebar">
            <div class="emp-logo">
                <div class="emp-logo-icon">
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <rect x="1" y="5" width="15" height="11" rx="1" fill="#1a1a1a" />
                        <path d="M16 9h4l3 4v3h-7V9z" fill="#1a1a1a" />
                        <circle cx="5.5" cy="18.5" r="2.5" fill="#1a1a1a" />
                        <circle cx="18.5" cy="18.5" r="2.5" fill="#1a1a1a" />
                    </svg>
                </div>
                <span class="emp-logo-text">AUTO<span class="logo-y">BASE</span></span>
            </div>

            <nav class="emp-nav">
                <div class="nav-label">Overview</div>
                <a href="#" class="nav-link active">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="3" width="7" height="7" />
                        <rect x="14" y="3" width="7" height="7" />
                        <rect x="14" y="14" width="7" height="7" />
                        <rect x="3" y="14" width="7" height="7" />
                    </svg>
                    Dashboard
                </a>

                <div class="nav-label">Vehicles</div>
                <a href="@Url.Action("AvailableVehicles", "EmployeeDashboard")" class="nav-link">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M22 11.08V12a10 10 0 11-5.93-9.14" />
                        <polyline points="22 4 12 14.01 9 11.01" />
                    </svg>
                    Available Vehicles
                </a>
                <a href="@Url.Action("Allocated", "Vehicle")" class="nav-link">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z" />
                        <circle cx="12" cy="10" r="3" />
                    </svg>
                    My Allocated Vehicle
                </a>

                <div class="nav-label">Requests</div>
                <a href="@Url.Action("MyRequests", "EmployeeDashboard")" class="nav-link">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z" />
                        <polyline points="14 2 14 8 20 8" />
                        <line x1="16" y1="13" x2="8" y2="13" />
                        <line x1="16" y1="17" x2="8" y2="17" />
                    </svg>
                    My Requests
                </a>
                <a href="@Url.Action("NewRequest", "EmployeeDashboard")" class="nav-link">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10" />
                        <line x1="12" y1="8" x2="12" y2="16" />
                        <line x1="8" y1="12" x2="16" y2="12" />
                    </svg>
                    New Request
                </a>
            </nav>

            <div class="emp-sidebar-footer">
                <div class="emp-s-avatar">@initials</div>
                <div class="emp-s-info">
                    <span class="emp-s-name">@fullName</span>
                    <span class="emp-s-meta">Employee &middot; #@empNo</span>
                </div>
            </div>
        </aside>

        <!-- Main -->
        <div class="emp-main">
            <!-- Topbar -->
            <header class="emp-topbar">
                <div>
                    <div class="topbar-greet">@greeting, @fullName ??</div>
                    <div class="topbar-sub">Here's your vehicle status for today</div>
                </div>
                <div class="topbar-right">
                    <div class="user-pill">
                        <div class="pill-avatar">@initials</div>
                        <div>
                            <div class="pill-name">@fullName</div>
                            <div class="pill-role">Employee</div>
                        </div>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#999" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="6 9 12 15 18 9" />
                        </svg>
                    </div>
                    <a href="@Url.Action("Logout", "Account")" class="logout-btn">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4" />
                            <polyline points="16 17 21 12 16 7" />
                            <line x1="21" y1="12" x2="9" y2="12" />
                        </svg>
                        Logout
                    </a>
                </div>
            </header>

            <div class="emp-body">
                <!-- Welcome -->
                <div class="emp-welcome">
                    <div>
                        <div class="emp-welcome-title">Welcome back, @fullName 👋</div>
                        <div class="emp-welcome-sub">Your vehicle dashboard &nbsp;| Emp No: <span>#@empNo</span></div>
                    </div>
                    <div class="emp-badge">Employee</div>
                </div>

                <!-- Stats -->
                <div class="emp-stats">
                    <div class="emp-stat s1">
                        <div class="emp-stat-icon y">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z" />
                                <polyline points="14 2 14 8 20 8" />
                            </svg>
                        </div>
                        <div class="emp-stat-num">0</div>
                        <div class="emp-stat-lbl">Total Requests</div>
                    </div>
                    <div class="emp-stat s2">
                        <div class="emp-stat-icon g">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M22 11.08V12a10 10 0 11-5.93-9.14" />
                                <polyline points="22 4 12 14.01 9 11.01" />
                            </svg>
                        </div>
                        <div class="emp-stat-num">0</div>
                        <div class="emp-stat-lbl">Approved</div>
                    </div>
                    <div class="emp-stat s3">
                        <div class="emp-stat-icon r">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="10" />
                                <line x1="15" y1="9" x2="9" y2="15" />
                                <line x1="9" y1="9" x2="15" y2="15" />
                            </svg>
                        </div>
                        <div class="emp-stat-num">0</div>
                        <div class="emp-stat-lbl">Rejected</div>
                    </div>
                </div>

                <!-- New Request Quick Form -->
                <div class="req-card">
                    <div class="req-card-title">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
                        </svg>
                        Quick Vehicle Request
                    </div>
                    @using (Html.BeginForm("New", "Request", FormMethod.Post, new { @class = "req-form" }))
                    {
                        @Html.AntiForgeryToken()
                        <div class="req-field">
                            <label>Purpose</label>
                            <input type="text" name="Purpose" placeholder="e.g. Client visit, site inspection" />
                        </div>
                        <div class="req-field">
                            <label>From Date</label>
                            <input type="date" name="FromDate" />
                        </div>
                        <div class="req-field">
                            <label>To Date</label>
                            <input type="date" name="ToDate" />
                        </div>
                        <button type="submit" class="req-submit">Submit Request</button>
                    }
                </div>

                <!-- Recent Activity -->
                <div class="emp-bottom-grid">
                    <div class="emp-card">
                        <div class="emp-card-header">
                            <div class="emp-card-title">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z" />
                                    <polyline points="14 2 14 8 20 8" />
                                </svg>
                                My Recent Requests
                            </div>
                        </div>
                        <table class="emp-table">
                            <thead>
                                <tr>
                                    <th>Purpose</th>
                                    <th>Date</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td colspan="3" class="empty-state">No requests submitted yet.</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <div class="emp-card">
                        <div class="emp-card-header">
                            <div class="emp-card-title">
