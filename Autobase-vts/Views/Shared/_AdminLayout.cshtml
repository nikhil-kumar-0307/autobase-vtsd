<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - AutoBase</title>
    <link href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600;700;800&family=Barlow+Condensed:wght@700;800&display=swap" rel="stylesheet" />
    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Barlow', sans-serif;
            background: #f8f8f8;
            color: #0d0d0d;
        }

        .admin-layout {
            display: flex;
            min-height: 100vh;
        }

        .main-content {
            margin-left: 200px;
            padding-top: 60px;
            flex: 1;
            min-height: 100vh;
        }

        .page-body {
            padding: 28px;
        }
    </style>
    @RenderSection("Styles", required: false)
</head>
<body>
    <div class="admin-layout">
        @Html.Partial("_AdminSidebar")
        <div class="main-content">
            @Html.Partial("_AdminTopbar")
            <div class="page-body">
                @RenderBody()
            </div>
        </div>
    </div>
    @RenderSection("Scripts", required: false)
</body>
</html>
