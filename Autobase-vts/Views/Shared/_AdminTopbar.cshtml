@{
    string role = Session["Role"]?.ToString() ?? "";
    string fullName = Session["FullName"]?.ToString() ?? "User";
    string empNo = Session["EmployeeNumber"]?.ToString() ?? "";
    string initials = string.IsNullOrEmpty(fullName) ? "U" : fullName.Substring(0, 1).ToUpper();

    var now = DateTime.Now;
    int hour = now.Hour;
    string greeting = hour < 12 ? "Good morning" : hour < 17 ? "Good afternoon" : "Good evening";
}

<header class="topbar">
    <div class="topbar-left">
        <div class="topbar-greeting">@greeting, @fullName ??</div>
        <div class="topbar-sub">Here's what's happening today</div>
    </div>
    <div class="topbar-right">
        <div class="topbar-user-pill">
            <div class="topbar-avatar">@initials</div>
            <div class="topbar-user-info">
                <span class="topbar-user-name">@fullName</span>
                <span class="topbar-user-role">@role</span>
            </div>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#999" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9" />
            </svg>
        </div>
        <a href="@Url.Action("Logout", "Account")" class="topbar-logout-btn">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4" />
                <polyline points="16 17 21 12 16 7" />
                <line x1="21" y1="12" x2="9" y2="12" />
            </svg>
            Logout
        </a>
    </div>
</header>

<style>
    .topbar {
        height: 60px;
        background: #ffffff;
        border-bottom: 1px solid #f0f0f0;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 28px;
        position: fixed;
        top: 0;
        left: 200px;
        right: 0;
        z-index: 99;
    }

    .topbar-greeting {
        font-size: 14px;
        font-weight: 600;
        color: #0d0d0d;
    }

    .topbar-sub {
        font-size: 12px;
        color: #aaa;
        margin-top: 1px;
    }

    .topbar-right {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .topbar-user-pill {
        display: flex;
        align-items: center;
        gap: 9px;
        background: #f7f7f7;
        border: 1px solid #ebebeb;
        border-radius: 50px;
        padding: 5px 12px 5px 5px;
        cursor: pointer;
    }

    .topbar-avatar {
        width: 30px;
        height: 30px;
        border-radius: 50%;
        background: #F5C518;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 13px;
        font-weight: 700;
        color: #0d0d0d;
        flex-shrink: 0;
    }

    .topbar-user-info {
        display: flex;
        flex-direction: column;
        line-height: 1.2;
    }

    .topbar-user-name {
        font-size: 12px;
        font-weight: 600;
        color: #0d0d0d;
    }

    .topbar-user-role {
        font-size: 10px;
        color: #999;
    }

    .topbar-logout-btn {
        display: flex;
        align-items: center;
        gap: 7px;
        padding: 8px 16px;
        border: 1.5px solid #eee;
        border-radius: 8px;
        font-family: 'Barlow', sans-serif;
        font-size: 13px;
        font-weight: 600;
        color: #555;
        text-decoration: none;
        background: #fff;
        transition: border-color .2s, color .2s, background .2s;
    }

        .topbar-logout-btn:hover {
            border-color: #e53e3e;
            color: #e53e3e;
            background: #fff5f5;
        }
</style>
