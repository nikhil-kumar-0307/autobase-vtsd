@{
    string fullName = Session["FullName"]?.ToString() ?? "Employee";
    string empNo = Session["EmployeeNumber"]?.ToString() ?? "";
    string initials = string.IsNullOrEmpty(fullName) ? "E" : fullName.Substring(0, 1).ToUpper();

    var now = DateTime.Now;
    int hour = now.Hour;
    string greeting = hour < 12 ? "Good morning" : hour < 17 ? "Good afternoon" : "Good evening";

    string activeNav = ViewBag.ActiveNav as string ?? "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>AutoBase &mdash; @ViewBag.Title</title>
    <link href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600;700;800&family=Barlow+Condensed:wght@700;800&display=swap" rel="stylesheet" />
    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Barlow', sans-serif;
            background: #f8f8f8;
            color: #0d0d0d;
            min-height: 100vh;
        }

        .emp-layout {
            display: flex;
            min-height: 100vh;
        }

        /* ── Sidebar ── */
        .emp-sidebar {
            width: 200px;
            min-width: 200px;
            background: #fff;
            border-right: 1px solid #f0f0f0;
            display: flex;
            flex-direction: column;
            height: 100vh;
            position: fixed;
            left: 0;
            top: 0;
            z-index: 100;
        }

        .emp-logo {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 20px 16px 16px;
            border-bottom: 1px solid #f5f5f5;
        }

        .emp-logo-icon {
            width: 32px;
            height: 32px;
            background: #F5C518;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .emp-logo-icon svg {
                width: 20px;
                height: 20px;
            }

        .emp-logo-text {
            font-family: 'Barlow Condensed', sans-serif;
            font-size: 17px;
            font-weight: 800;
            letter-spacing: 1px;
            color: #0d0d0d;
        }

        .logo-y {
            color: #F5C518;
        }

        .emp-nav {
            flex: 1;
            padding: 12px 10px;
            display: flex;
            flex-direction: column;
            gap: 1px;
        }

        .nav-label {
            font-size: 9px;
            font-weight: 700;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            color: #bbb;
            padding: 10px 8px 4px;
            margin-top: 4px;
        }

        .nav-link {
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 8px 10px;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 500;
            color: #555;
            text-decoration: none;
            transition: background .15s, color .15s;
        }

            .nav-link svg {
                flex-shrink: 0;
                opacity: .7;
            }

            .nav-link:hover {
                background: #f7f7f7;
                color: #0d0d0d;
            }

                .nav-link:hover svg {
                    opacity: 1;
                }

            .nav-link.active {
                background: #fff8dc;
                color: #0d0d0d;
                font-weight: 600;
            }

                .nav-link.active svg {
                    opacity: 1;
                    color: #c9a000;
                }

        .emp-sidebar-footer {
            padding: 14px;
            border-top: 1px solid #f0f0f0;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .emp-s-avatar {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            background: #F5C518;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
            font-weight: 700;
            color: #0d0d0d;
            flex-shrink: 0;
        }

        .emp-s-info {
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        .emp-s-name {
            font-size: 12px;
            font-weight: 600;
            color: #0d0d0d;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .emp-s-meta {
            font-size: 10px;
            color: #999;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        /* ── Topbar ── */
        .emp-topbar {
            height: 60px;
            background: #fff;
            border-bottom: 1px solid #f0f0f0;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 28px;
            position: fixed;
            top: 0;
            left: 200px;
            right: 0;
            z-index: 99;
        }

        .topbar-greet {
            font-size: 14px;
            font-weight: 600;
            color: #0d0d0d;
        }

        .topbar-sub {
            font-size: 12px;
            color: #aaa;
            margin-top: 1px;
        }

        .topbar-right {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        /* ── Profile pill + dropdown (shared markup lives in _ProfilePanel partial) ── */
        .user-pill-wrap {
            position: relative;
        }

        .user-pill {
            display: flex;
            align-items: center;
            gap: 9px;
            background: #f7f7f7;
            border: 1px solid #ebebeb;
            border-radius: 50px;
            padding: 5px 12px 5px 5px;
            cursor: pointer;
            transition: background .15s;
        }

            .user-pill:hover {
                background: #f0f0f0;
            }

        .pill-avatar {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            background: #F5C518;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 13px;
            font-weight: 700;
            color: #0d0d0d;
        }

        .pill-name {
            font-size: 12px;
            font-weight: 600;
            color: #0d0d0d;
        }

        .pill-role {
            font-size: 10px;
            color: #999;
        }

        #empProfileChevron {
            transition: transform .2s;
        }

        .user-pill-wrap.open #empProfileChevron {
            transform: rotate(180deg);
        }

        .profile-panel {
            display: none;
            position: absolute;
            top: calc(100% + 10px);
            right: 0;
            width: 300px;
            background: #fff;
            border: 1px solid #ececec;
            border-radius: 14px;
            box-shadow: 0 12px 32px rgba(0,0,0,.12);
            padding: 18px;
            z-index: 200;
            font-family: 'Barlow', sans-serif;
        }

        .user-pill-wrap.open .profile-panel {
            display: block;
        }

        .profile-panel-loading {
            font-size: 13px;
            color: #999;
            text-align: center;
            padding: 20px 0;
        }

        .profile-panel-header {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 14px;
        }

        .profile-panel-avatar {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            background: #F5C518;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 17px;
            font-weight: 700;
            color: #0d0d0d;
            flex-shrink: 0;
        }

        .profile-panel-name {
            font-size: 15px;
            font-weight: 700;
            color: #0d0d0d;
        }

        .profile-panel-role {
            font-size: 11px;
            font-weight: 600;
            color: #b45309;
            background: #fffbeb;
            border: 1px solid #fde68a;
            border-radius: 20px;
            padding: 1px 9px;
            display: inline-block;
            margin-top: 3px;
        }

        .profile-panel-body {
            display: flex;
            flex-direction: column;
            gap: 9px;
            margin-bottom: 14px;
        }

        .profile-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 12px;
        }

            .profile-row span {
                color: #999;
            }

            .profile-row strong {
                color: #0d0d0d;
                font-weight: 600;
                text-align: right;
                max-width: 170px;
                word-break: break-word;
            }

        .profile-panel-divider {
            height: 1px;
            background: #f0f0f0;
            margin: 4px 0 14px;
        }

        .profile-pwd-toggle {
            width: 100%;
            background: #fafafa;
            border: 1.5px solid #ececec;
            border-radius: 9px;
            padding: 10px;
            font-family: 'Barlow', sans-serif;
            font-size: 13px;
            font-weight: 600;
            color: #444;
            cursor: pointer;
            transition: border-color .2s, background .2s;
        }

            .profile-pwd-toggle:hover {
                border-color: #cbd5e0;
                background: #fff;
            }

        .profile-input {
            width: 100%;
            height: 40px;
            padding: 0 12px;
            border: 1.5px solid #e8e8e8;
            border-radius: 9px;
            font-family: 'Barlow', sans-serif;
            font-size: 13px;
            margin-bottom: 9px;
            outline: none;
            box-sizing: border-box;
            transition: border-color .2s;
        }

            .profile-input:focus {
                border-color: #3182ce;
            }

        .profile-pwd-message {
            font-size: 11.5px;
            margin-bottom: 8px;
            min-height: 14px;
        }

            .profile-pwd-message.error {
                color: #e53e3e;
            }

            .profile-pwd-message.success {
                color: #166534;
            }

        .profile-pwd-actions {
            display: flex;
            gap: 8px;
        }

        .profile-pwd-cancel, .profile-pwd-save {
            flex: 1;
            height: 38px;
            border-radius: 8px;
            font-family: 'Barlow', sans-serif;
            font-size: 13px;
            font-weight: 700;
            cursor: pointer;
            border: none;
        }

        .profile-pwd-cancel {
            background: #f5f5f5;
            color: #555;
        }

        .profile-pwd-save {
            background: #F5C518;
            color: #0d0d0d;
        }

            .profile-pwd-save:hover {
                background: #e6b800;
            }

            .profile-pwd-save:disabled {
                opacity: .6;
                cursor: not-allowed;
            }

        .profile-pwd-unavailable {
            font-size: 11.5px;
            color: #999;
            font-style: italic;
            text-align: center;
            padding: 6px 0;
        }

        .logout-btn {
            display: flex;
            align-items: center;
            gap: 7px;
            padding: 8px 16px;
            border: 1.5px solid #eee;
            border-radius: 8px;
            font-family: 'Barlow', sans-serif;
            font-size: 13px;
            font-weight: 600;
            color: #555;
            text-decoration: none;
            background: #fff;
            transition: border-color .2s, color .2s, background .2s;
        }

            .logout-btn:hover {
                border-color: #e53e3e;
                color: #e53e3e;
                background: #fff5f5;
            }

        /* ── Main ── */
        .emp-main {
            margin-left: 200px;
            padding-top: 60px;
            flex: 1;
        }

        .emp-body {
            padding: 28px;
        }

        @@keyframes fadeUp {
            from {
                opacity: 0;
                transform: translateY(12px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
    </style>
    @RenderSection("Styles", required: false)
</head>
<body>
    <div class="emp-layout">

        <!-- Sidebar -->
        <aside class="emp-sidebar">
            <div class="emp-logo">
                <div class="emp-logo-icon">
                    <svg viewBox="0 0 24 24" fill="none">
                        <rect x="1" y="5" width="15" height="11" rx="1" fill="#1a1a1a" />
                        <path d="M16 9h4l3 4v3h-7V9z" fill="#1a1a1a" />
                        <circle cx="5.5" cy="18.5" r="2.5" fill="#1a1a1a" />
                        <circle cx="18.5" cy="18.5" r="2.5" fill="#1a1a1a" />
                    </svg>
                </div>
                <span class="emp-logo-text">AUTO<span class="logo-y">BASE</span></span>
            </div>
            <nav class="emp-nav">
                <div class="nav-label">Overview</div>
                <a href="@Url.Action("Index","EmployeeDashboard")" class="nav-link @(activeNav == "Dashboard" ? "active" : "")">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="3" width="7" height="7" />
                        <rect x="14" y="3" width="7" height="7" />
                        <rect x="14" y="14" width="7" height="7" />
                        <rect x="3" y="14" width="7" height="7" />
                    </svg>
                    Dashboard
                </a>
                <div class="nav-label">Vehicles</div>
                <a href="@Url.Action("AvailableVehicles","EmployeeDashboard")" class="nav-link @(activeNav == "AvailableVehicles" ? "active" : "")">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M22 11.08V12a10 10 0 11-5.93-9.14" />
                        <polyline points="22 4 12 14.01 9 11.01" />
                    </svg>
                    Available Vehicles
                </a>
                <a href="@Url.Action("AllocatedVehicle","EmployeeDashboard")" class="nav-link @(activeNav == "AllocatedVehicle" ? "active" : "")">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z" />
                        <circle cx="12" cy="10" r="3" />
                    </svg>
                    My Allocated Vehicle
                </a>
                <div class="nav-label">Requests</div>
                <a href="@Url.Action("MyRequests","EmployeeDashboard")" class="nav-link @(activeNav == "MyRequests" ? "active" : "")">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z" />
                        <polyline points="14 2 14 8 20 8" />
                        <line x1="16" y1="13" x2="8" y2="13" />
                        <line x1="16" y1="17" x2="8" y2="17" />
                    </svg>
                    My Requests
                </a>
                <a href="@Url.Action("NewRequest","EmployeeDashboard")" class="nav-link @(activeNav == "NewRequest" ? "active" : "")">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10" />
                        <line x1="12" y1="8" x2="12" y2="16" />
                        <line x1="8" y1="12" x2="16" y2="12" />
                    </svg>
                    New Request
                </a>
            </nav>
            <div class="emp-sidebar-footer">
                <div class="emp-s-avatar">@initials</div>
                <div class="emp-s-info">
                    <span class="emp-s-name">@fullName</span>
                    <span class="emp-s-meta">Employee &middot; #@empNo</span>
                </div>
            </div>
        </aside>

        <!-- Main -->
        <div class="emp-main">
            <header class="emp-topbar">
                <div>
                    <div class="topbar-greet">@greeting, @fullName</div>
                    <div class="topbar-sub">@ViewBag.PageSubtitle</div>
                </div>
                <div class="topbar-right">
                    @Html.Partial("~/Views/EmployeeDashboard/_ProfilePanel.cshtml")

                    <a href="@Url.Action("Logout","Account")" class="logout-btn">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4" />
                            <polyline points="16 17 21 12 16 7" />
                            <line x1="21" y1="12" x2="9" y2="12" />
                        </svg>
                        Logout
                    </a>
                </div>
            </header>

            <div class="emp-body">
                @RenderBody()
            </div>
        </div>
    </div>

    @RenderSection("Scripts", required: false)
</body>
</html>
