@model autobase.Models.DTOs.VehicleReportDto
@{
    ViewBag.Title = "Vehicle Report";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
    <style>
        .page-title {
            font-size: 24px;
            font-weight: 800;
            color: #0d0d0d;
            letter-spacing: -.3px;
        }

        .page-sub {
            font-size: 13px;
            color: #aaa;
            margin-top: 3px;
            margin-bottom: 22px;
        }

        /* Summary stat cards */
        .stats-row {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 16px;
            margin-bottom: 22px;
        }

        .stat-card {
            background: #fff;
            border: 1px solid #efefef;
            border-radius: 14px;
            padding: 18px 20px;
            position: relative;
            overflow: hidden;
        }

            .stat-card::after {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 3px;
                background: #F5C518;
            }

        .stat-label {
            font-size: 9px;
            font-weight: 700;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            color: #bbb;
            margin-bottom: 8px;
        }

        .stat-num {
            font-size: 30px;
            font-weight: 800;
            color: #0d0d0d;
            line-height: 1;
        }

        /* Filter bar */
        .filter-card {
            background: #fff;
            border: 1px solid #efefef;
            border-radius: 14px;
            padding: 18px 20px;
            margin-bottom: 20px;
        }

        .filter-presets {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-bottom: 14px;
        }

        .preset-btn {
            height: 38px;
            padding: 0 16px;
            border: 1.5px solid #e8e8e8;
            border-radius: 9px;
            font-family: 'Barlow', sans-serif;
            font-size: 13px;
            font-weight: 600;
            color: #666;
            background: #fff;
            cursor: pointer;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            transition: border-color .15s, background .15s, color .15s;
        }

            .preset-btn:hover {
                border-color: #ccc;
                color: #0d0d0d;
            }

            .preset-btn.active {
                background: #0d0d0d;
                border-color: #0d0d0d;
                color: #fff;
            }

        .filter-form-row {
            display: flex;
            flex-wrap: wrap;
            align-items: flex-end;
            gap: 12px;
            border-top: 1px solid #f5f5f5;
            padding-top: 14px;
        }

        .filter-group {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .filter-label {
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #999;
        }

        .filter-input {
            height: 42px;
            padding: 0 12px;
            border: 1.5px solid #e8e8e8;
            border-radius: 9px;
            font-family: 'Barlow', sans-serif;
            font-size: 13px;
            font-weight: 500;
            color: #0d0d0d;
            background: #fff;
            outline: none;
            transition: border-color .2s;
        }

            .filter-input:focus {
                border-color: #F5C518;
            }

        .filter-search {
            flex: 1;
            min-width: 220px;
        }

        .btn-apply {
            height: 42px;
            padding: 0 22px;
            background: #F5C518;
            color: #0d0d0d;
            border: none;
            border-radius: 9px;
            font-family: 'Barlow', sans-serif;
            font-size: 13px;
            font-weight: 700;
            cursor: pointer;
            transition: background .2s;
        }

            .btn-apply:hover {
                background: #d4a800;
            }

        .range-readout {
            font-size: 12px;
            color: #999;
            margin-top: 12px;
        }

            .range-readout strong {
                color: #0d0d0d;
            }

        /* Section cards */
        .section-card {
            background: #fff;
            border: 1px solid #f0f0f0;
            border-radius: 14px;
            overflow: hidden;
            margin-bottom: 20px;
        }

        .section-header {
            padding: 16px 20px;
            border-bottom: 1px solid #f5f5f5;
            font-size: 14px;
            font-weight: 700;
            color: #0d0d0d;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .count-badge {
            background: #f5f5f5;
            color: #555;
            font-size: 11px;
            font-weight: 700;
            padding: 3px 10px;
            border-radius: 20px;
        }

        .section-card table {
            width: 100%;
            border-collapse: collapse;
        }

            .section-card table th {
                font-size: 9px;
                font-weight: 700;
                letter-spacing: 1.2px;
                text-transform: uppercase;
                color: #bbb;
                padding: 11px 20px;
                text-align: left;
                background: #fafafa;
                border-bottom: 1px solid #f0f0f0;
                white-space: nowrap;
            }

            .section-card table td {
                padding: 13px 20px;
                font-size: 13px;
                color: #555;
                border-bottom: 1px solid #f9f9f9;
                vertical-align: middle;
            }

            .section-card table tr:last-child td {
                border-bottom: none;
            }

            .section-card table tr:hover td {
                background: #fafafa;
            }

        .v-name {
            font-size: 13px;
            font-weight: 700;
            color: #0d0d0d;
        }

        .reg-tag {
            display: inline-block;
            font-size: 11px;
            font-weight: 700;
            padding: 3px 9px;
            border-radius: 6px;
            background: #f5f5f5;
            color: #555;
            border: 1px solid #eee;
            letter-spacing: .5px;
        }

        .status-pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 4px 12px;
            border-radius: 50px;
            font-size: 11px;
            font-weight: 700;
        }

        .status-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
        }

        .status-pill.approved {
            background: #dcfce7;
            color: #166534;
            border: 1px solid #bbf7d0;
        }

        .status-dot.approved {
            background: #38a169;
        }

        .status-pill.returned {
            background: #dbeafe;
            color: #1d4ed8;
            border: 1px solid #bfdbfe;
        }

        .status-dot.returned {
            background: #3182ce;
        }

        .purpose-cell {
            max-width: 180px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .empty-state {
            text-align: center;
            padding: 50px 20px;
        }

            .empty-state svg {
                color: #e0e0e0;
                margin-bottom: 12px;
            }

            .empty-state p {
                font-size: 13px;
                color: #bbb;
            }
    </style>
}

<!-- Page heading -->
<div class="page-title">Vehicle Usage Report</div>
<div class="page-sub">See which vehicles were used, by whom, and for how long over a chosen date range.</div>

<!-- Summary stat cards -->
<div class="stats-row">
    <div class="stat-card">
        <div class="stat-label">Total Trips</div>
        <div class="stat-num">@Model.TotalTrips</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Vehicles Used</div>
        <div class="stat-num">@Model.DistinctVehiclesUsed</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Total Hours</div>
        <div class="stat-num">@Model.TotalHoursUsed.ToString("0.#")</div>
    </div>
</div>

<!-- Filter card -->
<div class="filter-card">
    <div class="filter-presets">
        <a href="@Url.Action("VehicleReport", "Report", new { preset = "Today", search = Model.SearchTerm })"
           class="preset-btn @(Model.Preset == "Today" ? "active" : "")">Today</a>
        <a href="@Url.Action("VehicleReport", "Report", new { preset = "Last5", search = Model.SearchTerm })"
           class="preset-btn @(Model.Preset == "Last5" ? "active" : "")">Last 5 Days</a>
        <a href="@Url.Action("VehicleReport", "Report", new { preset = "Last7", search = Model.SearchTerm })"
           class="preset-btn @(Model.Preset == "Last7" ? "active" : "")">Last 7 Days</a>
        <a href="@Url.Action("VehicleReport", "Report", new { preset = "Last30", search = Model.SearchTerm })"
           class="preset-btn @(Model.Preset == "Last30" ? "active" : "")">Last 30 Days</a>
        <span class="preset-btn @(Model.Preset == "Custom" ? "active" : "")" style="cursor:default;">Custom Range</span>
    </div>

    @using (Html.BeginForm("VehicleReport", "Report", FormMethod.Get))
    {
        <div class="filter-form-row">
            <div class="filter-group">
                <label class="filter-label">From</label>
                <input type="date" class="filter-input" name="fromDate"
                       value="@Model.FromDate.ToString("yyyy-MM-dd")" />
            </div>
            <div class="filter-group">
                <label class="filter-label">To</label>
                <input type="date" class="filter-input" name="toDate"
                       value="@Model.ToDate.ToString("yyyy-MM-dd")" />
            </div>
            <div class="filter-group filter-search">
                <label class="filter-label">Search</label>
                <input type="text" class="filter-input" name="search"
                       placeholder="Vehicle name, registration no. or employee no…"
                       value="@Model.SearchTerm" />
            </div>
            <div class="filter-group">
                <button type="submit" class="btn-apply">Apply Filter</button>
            </div>
        </div>
    }

    <div class="range-readout">
        Showing usage from <strong>@Model.FromDate.ToString("dd MMM yyyy")</strong>
        to <strong>@Model.ToDate.ToString("dd MMM yyyy")</strong>
    </div>
</div>

<!-- Per-vehicle summary -->
<div class="section-card">
    <div class="section-header">
        Vehicle-wise Summary
        <span class="count-badge">@Model.VehicleSummaries.Count vehicles</span>
    </div>
    @if (!Model.VehicleSummaries.Any())
    {
        <div class="empty-state">
            <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="1" y="3" width="15" height="13" rx="1" />
                <path d="M16 8h4l3 4v3h-7V8z" />
                <circle cx="5.5" cy="18.5" r="2.5" />
                <circle cx="18.5" cy="18.5" r="2.5" />
            </svg>
            <p>No vehicle usage found in this date range.</p>
        </div>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th>Vehicle</th>
                    <th>Registration No.</th>
                    <th>Trips</th>
                    <th>Total Hours (in range)</th>
                    <th>Last Used</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var v in Model.VehicleSummaries)
                {
                    <tr>
                        <td><span class="v-name">@v.VehicleName</span></td>
                        <td><span class="reg-tag">@v.RegistrationNo</span></td>
                        <td>@v.TripCount</td>
                        <td>@v.TotalHours.ToString("0.#") hrs</td>
                        <td>@v.LastUsedOn.ToString("dd MMM yyyy, hh:mm tt")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<!-- Trip-level detail -->
<div class="section-card">
    <div class="section-header">
        Trip Details
        <span class="count-badge">@Model.Items.Count trips</span>
    </div>
    @if (!Model.Items.Any())
    {
        <div class="empty-state">
            <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z" />
                <polyline points="14 2 14 8 20 8" />
            </svg>
            <p>No trips recorded in this date range.</p>
        </div>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th>Vehicle</th>
                    <th>Reg No.</th>
                    <th>Employee</th>
                    <th>Department</th>
                    <th>From</th>
                    <th>To</th>
                    <th>Purpose</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    string sc = item.Status == "Returned" ? "returned" : "approved";
                    <tr>
                        <td><span class="v-name">@item.VehicleName</span></td>
                        <td><span class="reg-tag">@item.RegistrationNo</span></td>
                        <td>
                            @item.EmployeeName
                            <div style="font-size:11px;color:#bbb;">#@item.EmployeeNumber</div>
                        </td>
                        <td>@item.Department</td>
                        <td>@item.RequiredFrom.ToString("dd MMM, hh:mm tt")</td>
                        <td>@item.RequiredUntil.ToString("dd MMM, hh:mm tt")</td>
                        <td><span class="purpose-cell" title="@item.Purpose">@item.Purpose</span></td>
                        <td>
                            <span class="status-pill @sc">
                                <span class="status-dot @sc"></span>
                                @item.Status
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>